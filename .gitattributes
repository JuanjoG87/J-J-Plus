* text=auto eol=lf
# J/J+ uses .j; GitHub Linguist currently maps that extension to JASS.
# Hide .j from language statistics until J/J+ has an official Linguist definition.
*.j text eol=lf linguist-detectable=false
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.cff text eol=lf
*.o binary
*.ppm binary
*.zip binary
*.sha256 text eol=lf
artifacts/** linguist-generated=true
receipts/** linguist-generated=true
