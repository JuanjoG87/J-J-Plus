// R722 bounded ownership/borrow event checker foundation.
fn jj_borrow_step(st:*i64,event:i64)->i64{if st==0{return 0;}if st[4]!=0{return 0;}if event==1{if st[0]!=0{return 0;}st[0]=1;st[1]=0;st[2]=0;st[3]=0;return 1;}if st[0]==0{return 0;}if st[1]!=0{return 0;}if event==2{if st[3]!=0{return 0;}if st[2]>=31{return 0;}st[2]=st[2]+1;return 1;}if event==3{if st[2]<=0{return 0;}st[2]=st[2]-1;return 1;}if event==4{if st[2]!=0{return 0;}if st[3]!=0{return 0;}st[3]=1;return 1;}if event==5{if st[3]==0{return 0;}st[3]=0;return 1;}if event==6{if st[2]!=0{return 0;}if st[3]!=0{return 0;}st[1]=1;return 1;}if event==7{return 1;}if event==8{if st[2]!=0{return 0;}return 1;}if event==9{if st[2]!=0{return 0;}if st[3]!=0{return 0;}st[0]=0;return 1;}return 0;}
fn jj_borrow_check(events:*i64,n:i64,out:*i64)->i64{if events==0{return 0;}if out==0{return 0;}if n<1{return 0;}if n>128{return 0;}var st:[5]i64;var z:i64=0;while z<5{st[z]=0;z=z+1;}var i:i64=0;while i<n{if jj_borrow_step(st as *i64,events[i])==0{out[0]=i;out[1]=events[i];out[2]=st[2];out[3]=st[3];return 0;}i=i+1;}out[0]=n;out[1]=st[0];out[2]=st[1];out[3]=st[2]|(st[3]<<32);return 1;}
