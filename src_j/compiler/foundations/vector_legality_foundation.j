// Integer vectorization legality/cost foundation. No SIMD emission.
// Register availability belongs to the selected target profile. i386 can expose
// pressure with a small value, but cannot cap targets with wider register files.
fn jj_vec_admit(loop:*i64,target:*i64,out:*i64)->i64{if loop==0{return 0;}if target==0{return 0;}if out==0{return 0;}var bits:i64=loop[0];if bits!=8{if bits!=16{if bits!=32{if bits!=64{return 0;}}}}var iters:i64=loop[1];var loads:i64=loop[2];var stores:i64=loop[3];var reductions:i64=loop[4];var calls:i64=loop[5];var alias_safe:i64=loop[6];var traps:i64=loop[7];if calls!=0{return 0;}if alias_safe==0{return 0;}if traps!=0{return 0;}if reductions!=0{return 0;}if target[0]==0{return 0;}var lanes:i64=target[1];if lanes<2{return 0;}if iters<lanes*2{return 0;}var scalar:i64=iters*(loads+stores+1);var chunks:i64=(iters+lanes-1)/lanes;var vector:i64=chunks*(loads+stores+1)+2;if vector>=scalar{return 0;}out[0]=lanes;out[1]=chunks;out[2]=scalar;out[3]=vector;out[4]=iters%lanes;out[5]=bits;return 1;}
fn jj_vec_target_plan(arch:i64,simd_bits:i64,elem_bits:i64,out:*i64)->i64{if out==0{return 0;}var i:i64=0;while i<8{out[i]=0;i=i+1;}if elem_bits!=8{if elem_bits!=16{if elem_bits!=32{if elem_bits!=64{return 0;}}}}if simd_bits!=128{if simd_bits!=256{return 0;}}if arch==2{if simd_bits!=128{return 0;}}if arch==4{if simd_bits!=128{return 0;}}if arch==3{return 0;}if arch<1{return 0;}if arch>4{return 0;}var lanes:i64=simd_bits/elem_bits;if lanes<2{return 0;}out[0]=1;out[1]=lanes;out[2]=simd_bits/8;out[3]=elem_bits;out[4]=arch;if arch==1{out[5]=16;}else{out[5]=32;}return 1;}
fn jj_vec_remainder_plan(iters:i64,lanes:i64,body_nodes:i64,target_regs:i64,out:*i64)->i64{if out==0{return 0;}if iters<0{return 0;}if lanes<2{return 0;}if lanes>32{return 0;}if body_nodes<1{return 0;}if body_nodes>24{return 0;}if target_regs<3{return 0;}if target_regs>64{return 0;}var chunks:i64=iters/lanes;var rem:i64=iters%lanes;if chunks<2{return 0;}var growth:i64=body_nodes+6;if rem!=0{growth=growth+body_nodes;}if growth>54{return 0;}out[0]=chunks;out[1]=rem;out[2]=lanes;out[3]=growth;out[4]=0;if rem!=0{out[4]=1;}out[5]=target_regs;return 1;}
