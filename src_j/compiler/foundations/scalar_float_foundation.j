// R722 scalar floating-point foundation: IEEE classification and target policy only.
fn jj_fpf_classify(bits:i64,width:i64)->i64{var e:i64=0;var f:i64=0;if width==32{e=(bits>>>23)&255;f=bits&0x7fffff;if e==0{if f==0{return 1;}return 2;}if e==255{if f==0{return 4;}return 5;}return 3;}if width==64{e=(bits>>>52)&2047;f=bits&0x000fffffffffffff;if e==0{if f==0{return 1;}return 2;}if e==2047{if f==0{return 4;}return 5;}return 3;}return 0;}
fn jj_fpf_target_plan(desc:*i64,width:i64,op:i64,out:*i64)->i64{if desc==0{return 0;}if out==0{return 0;}if width!=32{if width!=64{return 0;}}if op<1{return 0;}if op>6{return 0;}var arch:i64=desc[0];var scalar:i64=desc[1];var has32:i64=desc[2];var has64:i64=desc[3];var regs:i64=desc[4];if scalar==0{return 0;}if width==32{if has32==0{return 0;}}else{if has64==0{return 0;}}if regs<4{return 0;}if arch<1{return 0;}if arch>4{return 0;}out[0]=arch;out[1]=width;out[2]=op;out[3]=regs;out[4]=0;out[5]=1;return 1;}
fn jj_fpf_sign(bits:i64,width:i64)->i64{if width==32{return (bits>>>31)&1;}if width==64{return (bits>>>63)&1;}return -1;}
fn jj_fpf_nan_kind(bits:i64,width:i64)->i64{if jj_fpf_classify(bits,width)!=5{return 0;}if width==32{if (bits&0x00400000)!=0{return 2;}return 1;}if width==64{if (bits&0x0008000000000000)!=0{return 2;}return 1;}return 0;}
fn jj_fpf_abi_plan(target:i64,width:i64,variadic:i64,out:*i64)->i64{if out==0{return 0;}var i:i64=0;while i<8{out[i]=0;i=i+1;}if width!=32{if width!=64{return 0;}}if variadic!=0{if variadic!=1{return 0;}}if target==1{if variadic!=0{return 0;}out[0]=1;out[1]=8;out[2]=16;out[3]=width;out[4]=1;return 1;}if target==2{if variadic!=0{return 0;}out[0]=1;out[1]=8;out[2]=16;out[3]=width;out[4]=1;return 1;}if target==3{out[0]=2;out[1]=0;out[2]=4;out[3]=width;out[4]=0;return 1;}if target==4{out[0]=2;out[1]=0;out[2]=4;out[3]=width;out[4]=0;return 1;}return 0;}
