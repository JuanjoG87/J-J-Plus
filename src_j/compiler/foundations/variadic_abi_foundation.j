// R722 integer-only variadic ABI cursor foundation. No language syntax or float varargs.
fn jj_vaf_plan(target:i64,out:*i64)->i64{if out==0{return 0;}var i:i64=0;while i<8{out[i]=0;i=i+1;}if target==1{out[0]=6;out[1]=0;out[2]=8;out[3]=8;out[4]=48;out[5]=1;return 1;}if target==2{out[0]=8;out[1]=0;out[2]=8;out[3]=8;out[4]=64;out[5]=1;return 1;}if target==3{out[0]=0;out[1]=0;out[2]=4;out[3]=4;out[4]=0;out[5]=1;return 1;}if target==4{out[0]=4;out[1]=0;out[2]=8;out[3]=4;out[4]=16;out[5]=1;return 1;}return 0;}
fn jj_vaf_next(plan:*i64,cursor:*i64,width:i64,kind:i64,out:*i64)->i64{if plan==0{return 0;}if cursor==0{return 0;}if out==0{return 0;}if plan[5]==0{return 0;}if kind!=1{return 0;}if width!=1{if width!=2{if width!=4{if width!=8{return 0;}}}}var slot:i64=plan[3];var align:i64=width;if align>plan[2]{align=plan[2];}if align<1{return 0;}var gp:i64=cursor[0];var stack:i64=cursor[1];if gp<plan[0]{out[0]=1;out[1]=gp;out[2]=width;cursor[0]=gp+1;return 1;}var at:i64=((stack+align-1)/align)*align;out[0]=2;out[1]=at;out[2]=width;cursor[1]=at+slot;return 1;}
fn jj_vaf_begin(plan:*i64,fixed_gp:i64,fixed_stack:i64,cursor:*i64)->i64{if plan==0{return 0;}if cursor==0{return 0;}if plan[5]==0{return 0;}if fixed_gp<0{return 0;}if fixed_stack<0{return 0;}if fixed_gp>plan[0]{fixed_gp=plan[0];}if fixed_stack>0x3fffffff{return 0;}cursor[0]=fixed_gp;cursor[1]=fixed_stack;cursor[2]=0;cursor[3]=0x5641435552534f52;return 1;}
fn jj_vaf_next_checked(plan:*i64,cursor:*i64,width:i64,kind:i64,out:*i64)->i64{if cursor==0{return 0;}if cursor[3]!=0x5641435552534f52{return 0;}var old_gp:i64=cursor[0];var old_stack:i64=cursor[1];if jj_vaf_next(plan,cursor,width,kind,out)==0{return 0;}if cursor[0]<old_gp{return 0;}if cursor[1]<old_stack{return 0;}if cursor[1]>0x3fffffff{return 0;}cursor[2]=cursor[2]+1;if cursor[2]>65535{return 0;}return 1;}
