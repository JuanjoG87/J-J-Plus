extern fn jj_cir_function_block_capacity(p0:i64)->i64;
extern fn jj_cir_function_node_capacity(p0:i64)->i64;
extern fn jj_cir_graph_v2_build(p0:*i64,p1:i64,p2:*i64,p3:i64,p4:*i64,p5:i64)->i64;
extern fn jj_nlf1_state_valid(p0:*i64)->i64;
