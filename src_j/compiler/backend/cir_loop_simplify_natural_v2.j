extern fn jj_nlf1_desc_seal(p0:*i64)->i64;
extern fn jj_nlf1_header(p0:*i64,p1:i64)->i64;
extern fn jj_nlf1_member(p0:*i64,p1:i64,p2:i64)->i64;
extern fn jj_nlf1_record_field(p0:*i64,p1:i64,p2:i64)->i64;
extern fn jj_tx1_protect_digest(p0:*i64,p1:i64)->i64;
extern fn jj_tx1_desc_seal(p0:*i64)->i64;
extern fn jj_tx1_commit(p0:*i64)->i64;
fn jj_ls2_zero(p:*i64,n:i64)->i64{if p==0{return 0;}if n<0{return 0;}var i:i64=0;while i<n{p[i]=0;i=i+1;}return 1;}
fn jj_ls2_at(p:*i64,o:i64)->*i64{return ((p as i64)+o*8) as *i64;}
fn jj_ls2_disjoint(a:*i64,an:i64,b:*i64,bn:i64)->i64{if a==0{return 0;}if b==0{return 0;}if an<=0{return 0;}if bn<=0{return 0;}if an>0x0fffffffffffffff{return 0;}if bn>0x0fffffffffffffff{return 0;}var av:i64=a as i64;var bv:i64=b as i64;if av<0{return 0;}if bv<0{return 0;}var az:i64=an*8;var bz:i64=bn*8;if av>0x7fffffffffffffff-az{return 0;}if bv>0x7fffffffffffffff-bz{return 0;}var ae:i64=av+az;var be:i64=bv+bz;if ae<=bv{return 1;}if be<=av{return 1;}return 0;}
fn jj_ls2_req_seal(q:*i64)->i64{if q==0{return 0;}var h:i64=(q as i64)^0x4a4a4c5332525132;var i:i64=0;while i<16{var v:i64=q[i];if i==15{v=0;}h=((h<<7)|(h>>>57))^v^((i+17)*0x9e37);i=i+1;}if h==0{h=1;}return h;}
fn jj_ls2_binary(op:i64)->i64{if op==9{return 1;}if op==10{return 1;}if op==11{return 1;}if op==16{return 1;}if op==17{return 1;}if op==18{return 1;}return 0;}
fn jj_ls2_grec(b:i64)->i64{return 16+(b-1)*8;}
fn jj_ls2_succ(g:*i64,b:i64,i:i64)->i64{return g[jj_ls2_grec(b)+i];}
fn jj_ls2_succ_count(g:*i64,b:i64)->i64{var n:i64=0;if jj_ls2_succ(g,b,0)>0{n=n+1;}if jj_ls2_succ(g,b,1)>0{n=n+1;}return n;}
fn jj_ls2_external_count(f:*i64,id:i64,h:i64)->i64{var g:*i64=f[2] as *i64;var b:i64=1;var n:i64=0;while b<=f[7]{if jj_nlf1_member(f,id,b)==0{if jj_ls2_succ(g,b,0)==h{n=n+1;}if jj_ls2_succ(g,b,1)==h{n=n+1;}}b=b+1;}return n;}
fn jj_ls2_external_one(f:*i64,id:i64,h:i64)->i64{var g:*i64=f[2] as *i64;var b:i64=1;var p:i64=0;while b<=f[7]{if jj_nlf1_member(f,id,b)==0{if jj_ls2_succ(g,b,0)==h{if p!=0{return 0;}p=b;}if jj_ls2_succ(g,b,1)==h{if p!=0{return 0;}p=b;}}b=b+1;}return p;}
fn jj_ls2_already(f:*i64,id:i64,h:i64)->i64{if jj_ls2_external_count(f,id,h)!=1{return 0;}var p:i64=jj_ls2_external_one(f,id,h);if p<=0{return 0;}var g:*i64=f[2] as *i64;if jj_ls2_succ_count(g,p)!=1{return 0;}return 1;}
fn jj_ls2_graph_need(f:*i64)->i64{var g:*i64=f[2] as *i64;var b:i64=g[4]+1;var e:i64=g[5]+1;if b>0x0fffffffffffffff/9{return 0;}var n:i64=16+b*9;if n>0x7fffffffffffffff-e{return 0;}return n+e;}
fn jj_ls2_workspace_required(f:*i64,ocs:i64,ogs:i64)->i64{if jj_nlf1_state_valid(f)==0{return 0;}if ocs<64{return 0;}if ocs>65536{return 0;}if ogs<=0{return 0;}if ogs>65536{return 0;}var g:*i64=f[2] as *i64;var c:*i64=f[4] as *i64;if jj_cir_function_block_capacity(ocs)<c[2]+1{return 0;}if jj_cir_function_node_capacity(ocs)<c[3]+1{return 0;}var gn:i64=jj_ls2_graph_need(f);if gn<=0{return 0;}if ogs<gn{return 0;}var gw:i64=(g[4]+1)*7;var total:i64=24+f[10]+f[12]+f[14]+f[16]+f[17]*2+g[6]+g[14];if total>0x7fffffffffffffff-ocs{return 0;}total=total+ocs;if total>0x7fffffffffffffff-gn{return 0;}total=total+gn;if total>0x7fffffffffffffff-gw{return 0;}total=total+gw;if total>0x7fffffffffffffff-gn{return 0;}total=total+gn;if total>0x7fffffffffffffff-gw{return 0;}total=total+gw;if total>0x7fffffffffffffff-ocs{return 0;}total=total+ocs;if total>0x7fffffffffffffff-ogs{return 0;}return total+ogs;}
fn jj_ls2_protect_disjoint(p:*i64,n:i64,t:*i64,c:i64)->i64{if c<0{return 0;}if c==0{return 1;}if t==0{return 0;}var i:i64=0;while i<c{if jj_ls2_disjoint(p,n,t[i*2] as *i64,t[i*2+1])==0{return 0;}i=i+1;}return 1;}
fn jj_ls2_source_disjoint(p:*i64,n:i64,f:*i64)->i64{if jj_ls2_disjoint(p,n,f,24)==0{return 0;}if jj_ls2_disjoint(p,n,f[9] as *i64,f[10])==0{return 0;}if jj_ls2_disjoint(p,n,f[11] as *i64,f[12])==0{return 0;}if jj_ls2_disjoint(p,n,f[13] as *i64,f[14])==0{return 0;}if jj_ls2_disjoint(p,n,f[15] as *i64,f[16])==0{return 0;}if jj_ls2_disjoint(p,n,f[2] as *i64,f[3])==0{return 0;}if jj_ls2_disjoint(p,n,f[4] as *i64,f[5])==0{return 0;}return 1;}
fn jj_ls2_preflight(q:*i64)->i64{if q==0{return 0;}if q[0]!=0x4a4a4c5332525132{return 0;}if q[13]!=(q as i64){return 0;}if q[14]!=0{return 0;}if q[15]!=jj_ls2_req_seal(q){return 0;}var f:*i64=q[1] as *i64;if jj_nlf1_state_valid(f)==0{return 0;}if q[2]<=0{return 0;}if q[2]>f[8]{return 0;}var h:i64=jj_nlf1_header(f,q[2]);if h<=1{return 0;}if jj_ls2_external_count(f,q[2],h)<=0{return 0;}if jj_ls2_already(f,q[2],h)!=0{return 0;}if q[3]==0{return 0;}if q[5]==0{return 0;}if q[7]==0{return 0;}if q[9]==0{if q[10]!=0{return 0;}}else{if q[10]<=0{return 0;}}if q[11]!=0{if q[12]<16{return 0;}}else{if q[12]!=0{return 0;}}var need:i64=jj_ls2_workspace_required(f,q[4],q[6]);if need<=0{return 0;}if q[8]<need{return 0;}var oc:*i64=q[3] as *i64;var og:*i64=q[5] as *i64;var w:*i64=q[7] as *i64;if jj_ls2_disjoint(q,16,oc,q[4])==0{return 0;}if jj_ls2_disjoint(q,16,og,q[6])==0{return 0;}if jj_ls2_disjoint(q,16,w,q[8])==0{return 0;}if jj_ls2_disjoint(oc,q[4],og,q[6])==0{return 0;}if jj_ls2_disjoint(oc,q[4],w,q[8])==0{return 0;}if jj_ls2_disjoint(og,q[6],w,q[8])==0{return 0;}if jj_ls2_source_disjoint(oc,q[4],f)==0{return 0;}if jj_ls2_source_disjoint(og,q[6],f)==0{return 0;}if jj_ls2_source_disjoint(w,q[8],f)==0{return 0;}if q[10]>0{var t:*i64=q[9] as *i64;var tn:i64=q[10]*2;if jj_ls2_disjoint(q,16,t,tn)==0{return 0;}if jj_ls2_disjoint(oc,q[4],t,tn)==0{return 0;}if jj_ls2_disjoint(og,q[6],t,tn)==0{return 0;}if jj_ls2_disjoint(w,q[8],t,tn)==0{return 0;}if jj_ls2_protect_disjoint(oc,q[4],t,q[10])==0{return 0;}if jj_ls2_protect_disjoint(og,q[6],t,q[10])==0{return 0;}if jj_ls2_protect_disjoint(w,q[8],t,q[10])==0{return 0;}}if q[11]!=0{var rc:*i64=q[11] as *i64;if jj_ls2_disjoint(q,16,rc,q[12])==0{return 0;}if jj_ls2_disjoint(oc,q[4],rc,q[12])==0{return 0;}if jj_ls2_disjoint(og,q[6],rc,q[12])==0{return 0;}if jj_ls2_disjoint(w,q[8],rc,q[12])==0{return 0;}if jj_ls2_source_disjoint(rc,q[12],f)==0{return 0;}}return need;}
fn jj_ls2_node_map(first:i64,v:i64)->i64{if v>=first{return v+1;}return v;}
fn jj_ls2_block_map(h:i64,b:i64)->i64{if b>=h{return b+1;}return b;}
fn jj_ls2_target(f:*i64,id:i64,from:i64,to:i64)->i64{var h:i64=jj_nlf1_header(f,id);if to==h{if jj_nlf1_member(f,id,from)==0{return h;}}return jj_ls2_block_map(h,to);}
fn jj_ls2_copy_node(f:*i64,id:i64,out:*i64,os:i64,old:i64,nb:i64)->i64{var c:*i64=f[4] as *i64;var h:i64=jj_nlf1_header(f,id);var first:i64=c[12+(h-1)*6];var x:i64=c[11]+(old-1)*4;var op:i64=c[x];var a:i64=c[x+2];var b:i64=c[x+3];if op==3{a=jj_ls2_node_map(first,a);}if op==32{a=jj_ls2_node_map(first,a);}if op==33{a=jj_ls2_node_map(first,a);b=jj_ls2_node_map(first,b);}if op==36{a=jj_ls2_node_map(first,a);}if op==37{a=jj_ls2_node_map(first,a);}if jj_ls2_binary(op)!=0{a=jj_ls2_node_map(first,a);b=jj_ls2_node_map(first,b);}return jj_cir_function_add_node(out,os,nb,op,a,b)==jj_ls2_node_map(first,old);}
fn jj_ls2_set_term(f:*i64,id:i64,out:*i64,os:i64,oldb:i64,nb:i64)->i64{var c:*i64=f[4] as *i64;var h:i64=jj_nlf1_header(f,id);var first:i64=c[12+(h-1)*6];var q:i64=12+(oldb-1)*6;var t:i64=c[q+2];if t==1{return jj_cir_function_set_return(out,os,nb,jj_ls2_node_map(first,c[q+3]));}if t==2{var z:i64=jj_ls2_target(f,id,oldb,c[q+4]+1);if z<nb{return jj_cir_function_set_backedge(out,os,nb,z);}return jj_cir_function_set_jump(out,os,nb,z);}if t==3{return jj_cir_function_set_branch_zero(out,os,nb,jj_ls2_node_map(first,c[q+3]),jj_ls2_target(f,id,oldb,c[q+4]+1),jj_ls2_target(f,id,oldb,c[q+5]+1));}if t==4{return jj_cir_function_set_call_return(out,os,nb,jj_ls2_node_map(first,c[q+3]),c[q+4],c[q+5]);}return 0;}
fn jj_ls2_rebuild(f:*i64,id:i64,out:*i64,os:i64)->i64{var c:*i64=f[4] as *i64;var h:i64=jj_nlf1_header(f,id);var first:i64=c[12+(h-1)*6];if jj_cir_function_begin(out,os,c[4],c[5])==0{return 0;}var b:i64=1;while b<=c[2]+1{if jj_cir_function_add_block(out,os)!=b{return 0;}b=b+1;}b=1;while b<=c[2]+1{if b==h{var v:i64=jj_cir_function_add_node(out,os,b,2,0,0);if v!=first{return 0;}if jj_cir_function_set_jump(out,os,b,h+1)==0{return 0;}}else{var oldb:i64=b;if b>h{oldb=b-1;}var q:i64=12+(oldb-1)*6;var i:i64=0;while i<c[q+1]{if jj_ls2_copy_node(f,id,out,os,c[q]+i,b)==0{return 0;}i=i+1;}if jj_ls2_set_term(f,id,out,os,oldb,b)==0{return 0;}}b=b+1;}return jj_cir_function_finish(out,os);}
fn jj_ls2_forest_verify(f:*i64,w:*i64,o:*i64)->i64{var vs:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+24;var vr:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+f[10];var vm:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+f[12];var vl:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+f[14];var vo:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+f[16];var vw:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+f[17]*2;var rg:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+(f[2] as *i64)[6];var rw:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+(f[2] as *i64)[14];var d:[16]i64;d[0]=vm as i64;d[1]=f[12];d[2]=vl as i64;d[3]=f[14];d[4]=vo as i64;d[5]=f[16];d[6]=vw as i64;d[7]=f[17]*2;d[8]=rg as i64;d[9]=(f[2] as *i64)[6];d[10]=rw as i64;d[11]=(f[2] as *i64)[14];d[12]=d as i64;d[13]=f[3];d[14]=0;d[15]=0;d[15]=jj_nlf1_desc_seal(d as *i64);return jj_nlf1_verify(f,vs,vr,d as *i64);}
fn jj_ls2_commit(q:*i64,w:*i64,o:*i64,tc:*i64,tg:*i64,tw:*i64)->i64{var f:*i64=q[1] as *i64;var g:*i64=f[2] as *i64;var gn:i64=jj_ls2_graph_need(f);var gw:i64=(g[4]+1)*7;var rg:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+gn;var rw:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+gw;var bc:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+q[4];var bg:*i64=jj_ls2_at(w,o[0]);var d:[32]i64;d[0]=0x4a4a545831444553;d[1]=1;d[2]=q[3];d[3]=q[4];d[4]=q[5];d[5]=q[6];d[6]=tc as i64;d[7]=q[4];d[8]=tg as i64;d[9]=gn;d[10]=tw as i64;d[11]=gw;d[12]=rg as i64;d[13]=gn;d[14]=rw as i64;d[15]=gw;d[16]=bc as i64;d[17]=q[4];d[18]=bg as i64;d[19]=q[6];d[20]=q[9];d[21]=q[10];d[22]=q[11];d[23]=q[12];d[24]=d as i64;d[25]=0x7f;d[26]=1;d[27]=jj_tx1_protect_digest(q[9] as *i64,q[10]);d[28]=0;d[29]=0;d[31]=0;d[30]=jj_tx1_desc_seal(d as *i64);return jj_tx1_commit(d as *i64);}
fn jj_ls2_apply(q:*i64)->i64{var need:i64=jj_ls2_preflight(q);if need<=0{return 0;}var f:*i64=q[1] as *i64;var w:*i64=q[7] as *i64;var o:[1]i64;o[0]=0;if jj_ls2_forest_verify(f,w,o as *i64)==0{jj_ls2_zero(w,need);return 0;}if q[15]!=jj_ls2_req_seal(q){jj_ls2_zero(w,need);return 0;}var g:*i64=f[2] as *i64;var gn:i64=jj_ls2_graph_need(f);var gw:i64=(g[4]+1)*7;var tc:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+q[4];var tg:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+gn;var tw:*i64=jj_ls2_at(w,o[0]);o[0]=o[0]+gw;if jj_ls2_rebuild(f,q[2],tc,q[4])==0{jj_ls2_zero(w,need);return 0;}if jj_cir_graph_v2_build(tg,gn,tw,gw,tc,q[4])==0{jj_ls2_zero(w,need);return 0;}var ok:i64=jj_ls2_commit(q,w,o as *i64,tc,tg,tw);jj_ls2_zero(w,need);return ok;}
fn jj_ls2_resource_contract(out:*i64,n:i64)->i64{if out==0{return 0;}if n<24{return 0;}jj_ls2_zero(out,24);out[0]=2;out[1]=16;out[2]=6;out[3]=1;out[4]=1;out[5]=1;out[6]=1;out[7]=1;out[8]=1;out[9]=1;out[10]=1;out[11]=1;out[12]=0;out[13]=0;out[14]=0;out[15]=0;out[16]=0;out[17]=0;out[18]=0;out[19]=0;out[20]=0;out[21]=0;out[22]=0;out[23]=1;return 1;}
