// IA-32 external ABI identity. The visible source name is extended with the
// complete sealed semantic signature, matching the canonical x86-64 scheme.
fn jj_i386_abi_name_bytes(source_count:i64)->i64{if source_count<=0{return 0;}if source_count>0x7fffffff-18{return 0;}return source_count+18;}
fn jj_i386_abi_write_name(out:*i8,capacity:i64,at:i64,context:*i64)->i64{if out==0{return 0;}if context==0{return 0;}var source:*i8=context[0] as *i8;var start:i64=context[1];var count:i64=context[2];var signature:i64=context[3];if source==0{return 0;}if start<0{return 0;}if count<=0{return 0;}if signature==0{return 0;}var bytes:i64=jj_i386_abi_name_bytes(count);if bytes<=0{return 0;}if at<0{return 0;}if at>capacity-bytes{return 0;}var i:i64=0;while i<count{out[at+i]=source[start+i];i=i+1;}out[at+count]=36;i=0;while i<16{var digit:i64=(signature>>>((15-i)*4))&15;var character:i64=48+digit;if digit>=10{character=87+digit;}out[at+count+1+i]=character;i=i+1;}out[at+count+17]=0;return at+bytes;}
fn jj_i386_abi_names_resource_contract(out:*i64,slots:i64)->i64{if out==0{return 0;}if slots!=8{return 0;}out[0]=32;out[1]=32;out[2]=64;out[3]=1;out[4]=0;out[5]=1;out[6]=1;out[7]=(out as i64)^0x4a4a49334142494e;return 1;}
