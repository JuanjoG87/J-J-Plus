fn jj_cir_loop_successor(cir:*i64,block:i64,index:i64)->i64{if cir==0{return 0;}if block<=0{return 0;}if block>cir[2]{return 0;}if index<0{return 0;}if index>1{return 0;}var bb:i64=12+(block-1)*6;var term:i64=cir[bb+2];if term==2{if index!=0{return 0;}return cir[bb+4]+1;}if term==3{if index==0{return cir[bb+4]+1;}return cir[bb+5]+1;}return 0;}
fn jj_cir_loop_edge(cir:*i64,from:i64,to:i64)->i64{if cir==0{return 0;}if from<=0{return 0;}if to<=0{return 0;}if from>cir[2]{return 0;}if to>cir[2]{return 0;}if jj_cir_loop_successor(cir,from,0)==to{return 1;}if jj_cir_loop_successor(cir,from,1)==to{return 1;}return 0;}
