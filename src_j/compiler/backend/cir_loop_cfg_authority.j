}
fn jj_cir_loop_receipt_build(r:*i64,n:i64,cir:*i64,slots:i64)->i64{if r==0{return 0;}if n!=16{return 0;}if cir==0{return 0;}if ((r as i64)&7)!=0{return 0;}if ((cir as i64)&7)!=0{return 0;}if jj_cir_loop_ranges_disjoint(r,n,cir,slots)==0{return 0;}if jj_cir_loop_receipt_fill(r,cir,slots)==0{return 0;}r[14]=jj_cir_loop_receipt_seal(r);return r[14]!=0;}
fn jj_cir_loop_receipt_valid(r:*i64)->i64{if r==0{return 0;}if ((r as i64)&7)!=0{return 0;}if r[0]!=0x4a4a434c52533031{return 0;}if r[1]!=1{return 0;}if r[2]==0{return 0;}if (r[2]&7)!=0{return 0;}if r[3]<64{return 0;}if r[3]>65536{return 0;}if r[10]!=1{return 0;}if r[11]!=64{return 0;}if r[13]!=r[2]{return 0;}if r[15]!=0{return 0;}if r[14]!=jj_cir_loop_receipt_seal(r){return 0;}var expected:[16]i64;if jj_cir_loop_receipt_fill(expected as *i64,r[2] as *i64,r[3])==0{return 0;}var i:i64=4;while i<=13{if r[i]!=expected[i]{return 0;}i=i+1;}return 1;}
