fn jj_cir_loop_natural_member(cir:*i64,slots:i64,header:i64,latch:i64,block:i64)->i64{if block<=0{return 0;}if block>64{return 0;}var members:i64=jj_cir_loop_member_mask(cir,slots,header,latch);if members==0{return 0;}if (members&(1<<(block-1)))!=0{return 1;}return 0;}
fn jj_cir_loop_natural_size(cir:*i64,slots:i64,header:i64,latch:i64)->i64{var members:i64=jj_cir_loop_member_mask(cir,slots,header,latch);if members==0{return 0;}var count:i64=0;var block:i64=1;while block<=cir[2]{if (members&(1<<(block-1)))!=0{count=count+1;}block=block+1;}return count;}
fn jj_cir_loop_preheader(cir:*i64,slots:i64,header:i64,latch:i64)->i64{var members:i64=jj_cir_loop_member_mask(cir,slots,header,latch);if members==0{return 0;}var found:i64=0;var count:i64=0;var pred:i64=1;while pred<=cir[2]{if (members&(1<<(pred-1)))==0{if jj_cir_loop_edge(cir,pred,header)!=0{found=pred;count=count+1;}}pred=pred+1;}if count!=1{return 0;}if jj_cir_loop_successor(cir,found,0)!=header{return 0;}if jj_cir_loop_successor(cir,found,1)!=0{return 0;}return found;}
fn jj_cir_loop_exit_count(cir:*i64,slots:i64,header:i64,latch:i64)->i64{var members:i64=jj_cir_loop_member_mask(cir,slots,header,latch);if members==0{return 0;}var count:i64=0;var block:i64=1;while block<=cir[2]{if (members&(1<<(block-1)))!=0{var si:i64=0;while si<2{var target:i64=jj_cir_loop_successor(cir,block,si);if target>0{if (members&(1<<(target-1)))==0{count=count+1;}}si=si+1;}}block=block+1;}return count;}
fn jj_cir_loop_receipt_seal(r:*i64)->i64{if r==0{return 0;}var h:i64=(r as i64)^0x4a4a434c52533631;var i:i64=0;while i<16{var v:i64=r[i];if i==14{v=0;}h=((h<<9)|(h>>>55))^v^((i+7)*0x45d9f3b);i=i+1;}if h==0{h=1;}return h;}
fn jj_cir_loop_receipt_fill(r:*i64,cir:*i64,slots:i64)->i64{
