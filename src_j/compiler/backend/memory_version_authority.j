// R720 bounded object-version authority. The caller supplies fixed storage;
// there is no heap, no pointer-provenance inference and no unbounded search.
fn jj_mem_versions_seal(s:*i64,n:i64)->i64{if s==0{return 0;}if n<8{return 0;}var h:i64=0x4a4a4d5652533031^n;var i:i64=0;while i<n{var v:i64=s[i];if i==3{v=0;}h=((h<<7)|(h>>>57))^v^(i*0x9e3779b97f4a7c15);i=i+1;}if h==0{h=1;}return h;}
fn jj_mem_versions_capacity(n:i64)->i64{if n<8{return 0;}if n>132{return 0;}return (n-4)/4;}
fn jj_mem_versions_init(s:*i64,n:i64)->i64{if s==0{return 0;}var cap:i64=jj_mem_versions_capacity(n);if cap<=0{return 0;}var i:i64=0;while i<n{s[i]=0;i=i+1;}s[0]=0x4a4a4d5652533031;s[1]=0;s[2]=0;s[3]=jj_mem_versions_seal(s,n);return s[3]!=0;}
fn jj_mem_versions_valid(s:*i64,n:i64)->i64{if s==0{return 0;}var cap:i64=jj_mem_versions_capacity(n);if cap<=0{return 0;}if s[0]!=0x4a4a4d5652533031{return 0;}if s[1]<0{return 0;}if s[1]>cap{return 0;}if s[2]<0{return 0;}var i:i64=0;while i<cap{var at:i64=4+i*4;if i<s[1]{if s[at]<1{return 0;}if s[at]>3{return 0;}if s[at+1]<0{return 0;}if s[at+2]<1{return 0;}if s[at+3]<0{return 0;}if s[at+3]>1{return 0;}}else{if s[at]!=0{return 0;}if s[at+1]!=0{return 0;}if s[at+2]!=0{return 0;}if s[at+3]!=0{return 0;}}i=i+1;}return s[3]==jj_mem_versions_seal(s,n);}
fn jj_mem_versions_find(s:*i64,kind:i64,object_id:i64)->i64{var i:i64=0;while i<s[1]{var at:i64=4+i*4;if s[at]==kind{if s[at+1]==object_id{return i;}}i=i+1;}return 0-1;}
fn jj_mem_versions_touch(s:*i64,n:i64,kind:i64,object_id:i64)->i64{if jj_mem_versions_valid(s,n)==0{return 0-1;}if kind<1{return 0-1;}if kind>3{return 0-1;}if object_id<0{return 0-1;}var found:i64=jj_mem_versions_find(s,kind,object_id);if found>=0{return found;}var cap:i64=jj_mem_versions_capacity(n);if s[1]>=cap{return 0-1;}var i:i64=s[1];var at:i64=4+i*4;s[at]=kind;s[at+1]=object_id;s[at+2]=1;s[at+3]=0;s[1]=i+1;s[3]=jj_mem_versions_seal(s,n);if jj_mem_versions_valid(s,n)==0{return 0-1;}return i;}
fn jj_mem_versions_observe(s:*i64,n:i64,kind:i64,object_id:i64)->i64{var i:i64=jj_mem_versions_touch(s,n,kind,object_id);if i<0{return 0;}return s[4+i*4+2];}
fn jj_mem_versions_store(s:*i64,n:i64,kind:i64,object_id:i64)->i64{var i:i64=jj_mem_versions_touch(s,n,kind,object_id);if i<0{return 0;}var at:i64=4+i*4+2;if s[at]>=0x7fffffff{return 0;}s[at]=s[at]+1;s[3]=jj_mem_versions_seal(s,n);if jj_mem_versions_valid(s,n)==0{return 0;}return s[at];}
fn jj_mem_versions_unknown_call(s:*i64,n:i64)->i64{if jj_mem_versions_valid(s,n)==0{return 0;}if s[2]>=0x7fffffff{return 0;}var i:i64=0;while i<s[1]{var at:i64=4+i*4;if s[at]==2{if s[at+2]>=0x7fffffff{return 0;}s[at+2]=s[at+2]+1;}else{if s[at]==3{if s[at+2]>=0x7fffffff{return 0;}s[at+2]=s[at+2]+1;}}i=i+1;}s[2]=s[2]+1;s[3]=jj_mem_versions_seal(s,n);return jj_mem_versions_valid(s,n);}
fn jj_mem_versions_escape_local(s:*i64,n:i64,object_id:i64)->i64{var i:i64=jj_mem_versions_touch(s,n,1,object_id);if i<0{return 0;}var at:i64=4+i*4;if s[at+2]>=0x7fffffff{return 0;}s[at+2]=s[at+2]+1;s[at+3]=1;s[3]=jj_mem_versions_seal(s,n);return jj_mem_versions_valid(s,n);}
fn jj_mem_versions_local_forwardable(s:*i64,n:i64,object_id:i64)->i64{if jj_mem_versions_valid(s,n)==0{return 0;}var i:i64=jj_mem_versions_find(s,1,object_id);if i<0{return 1;}return s[4+i*4+3]==0;}
fn jj_mem_versions_resource_contract(out:*i64,n:i64)->i64{if out==0{return 0;}if n<8{return 0;}out[0]=132;out[1]=32;out[2]=4;out[3]=4;out[4]=0;out[5]=0;out[6]=0;out[7]=0;return 1;}
