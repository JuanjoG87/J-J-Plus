// R747 common CIR/Graph v2 transaction engine.
// i386 is a cost oracle only: u32-compatible geometry, at most six live values
// per helper, caller-owned buffers, no allocation, and no semantic count cap.
extern fn jj_cir_function_validate(p0:*i64,p1:i64)->i64;
extern fn jj_cir_graph_v2_build(p0:*i64,p1:i64,p2:*i64,p3:i64,p4:*i64,p5:i64)->i64;
extern fn jj_cir_graph_v2_valid(p0:*i64,p1:i64)->i64;
extern fn jj_cir_graph_v2_verify(p0:*i64,p1:i64,p2:*i64,p3:i64,p4:*i64,p5:i64)->i64;
fn jj_tx1_zero(p:*i64,n:i64)->i64{if p==0{return 0;}if n<0{return 0;}var i:i64=0;while i<n{p[i]=0;i=i+1;}return 1;}
fn jj_tx1_copy(d:*i64,s:*i64,n:i64)->i64{if d==0{return 0;}if s==0{return 0;}if n<0{return 0;}var i:i64=0;while i<n{d[i]=s[i];i=i+1;}return 1;}
fn jj_tx1_disjoint(a:*i64,an:i64,b:*i64,bn:i64)->i64{if a==0{return 0;}if b==0{return 0;}if an<=0{return 0;}if bn<=0{return 0;}if an>0x0fffffffffffffff{return 0;}if bn>0x0fffffffffffffff{return 0;}var av:i64=a as i64;var bv:i64=b as i64;if av<0{return 0;}if bv<0{return 0;}var az:i64=an*8;var bz:i64=bn*8;if av>0x7fffffffffffffff-az{return 0;}if bv>0x7fffffffffffffff-bz{return 0;}var ae:i64=av+az;var be:i64=bv+bz;if ae<=bv{return 1;}if be<=av{return 1;}return 0;}
fn jj_tx1_pair_ptr(d:*i64,i:i64)->*i64{return d[2+i*2] as *i64;}
fn jj_tx1_pair_slots(d:*i64,i:i64)->i64{return d[3+i*2];}
fn jj_tx1_protect_digest(t:*i64,n:i64)->i64{if n<0{return 0;}if n>0x07ffffffffffffff{return 0;}if n==0{if t!=0{return 0;}return 0x4a4a54583150524f;}if t==0{return 0;}var h:i64=0x4a4a54583150524f^n;var i:i64=0;while i<n{var p:i64=t[i*2];var z:i64=t[i*2+1];if p==0{return 0;}if z<=0{return 0;}if z>0x0fffffffffffffff{return 0;}h=((h<<9)|(h>>>55))^p^((z+i+1)*0x45d9f3b);i=i+1;}if h==0{h=1;}return h;}
fn jj_tx1_desc_seal(d:*i64)->i64{if d==0{return 0;}var h:i64=(d as i64)^0x4a4a545831444553;var i:i64=0;while i<32{var v:i64=d[i];if i==30{v=0;}h=((h<<7)|(h>>>57))^v^((i+19)*0x9e37);i=i+1;}if h==0{h=1;}return h;}
fn jj_tx1_receipt_seal(r:*i64)->i64{if r==0{return 0;}var h:i64=(r as i64)^0x4a4a545831524350;var i:i64=0;while i<16{var v:i64=r[i];if i==14{v=0;}h=((h<<11)|(h>>>53))^v^((i+23)*0x45d9f3b);i=i+1;}if h==0{h=1;}return h;}
fn jj_tx1_pairs_valid(d:*i64)->i64{var i:i64=0;while i<9{var p:*i64=jj_tx1_pair_ptr(d,i);if p==0{return 0;}if ((p as i64)&7)!=0{return 0;}if jj_tx1_pair_slots(d,i)<=0{return 0;}if jj_tx1_pair_slots(d,i)>0x0fffffffffffffff{return 0;}i=i+1;}i=0;while i<9{var j:i64=i+1;while j<9{if jj_tx1_disjoint(jj_tx1_pair_ptr(d,i),jj_tx1_pair_slots(d,i),jj_tx1_pair_ptr(d,j),jj_tx1_pair_slots(d,j))==0{return 0;}j=j+1;}i=i+1;}return 1;}
fn jj_tx1_external_disjoint(d:*i64)->i64{var t:*i64=d[20] as *i64;var n:i64=d[21];if n<0{return 0;}if n>0x07ffffffffffffff{return 0;}if n==0{if t!=0{return 0;}return 1;}if t==0{return 0;}var i:i64=0;while i<9{var j:i64=0;while j<n{if jj_tx1_disjoint(jj_tx1_pair_ptr(d,i),jj_tx1_pair_slots(d,i),t[j*2] as *i64,t[j*2+1])==0{return 0;}j=j+1;}i=i+1;}var r:*i64=d[22] as *i64;if r!=0{var j2:i64=0;while j2<n{if jj_tx1_disjoint(r,d[23],t[j2*2] as *i64,t[j2*2+1])==0{return 0;}j2=j2+1;}}return 1;}
fn jj_tx1_descriptor_disjoint(d:*i64)->i64{var i:i64=0;while i<9{if jj_tx1_disjoint(d,32,jj_tx1_pair_ptr(d,i),jj_tx1_pair_slots(d,i))==0{return 0;}i=i+1;}var t:*i64=d[20] as *i64;if d[21]>0{var tn:i64=d[21]*2;if ((t as i64)&7)!=0{return 0;}if jj_tx1_disjoint(d,32,t,tn)==0{return 0;}i=0;while i<9{if jj_tx1_disjoint(t,tn,jj_tx1_pair_ptr(d,i),jj_tx1_pair_slots(d,i))==0{return 0;}i=i+1;}}var r:*i64=d[22] as *i64;if r!=0{if ((r as i64)&7)!=0{return 0;}if jj_tx1_disjoint(d,32,r,d[23])==0{return 0;}if d[21]>0{if jj_tx1_disjoint(r,d[23],t,d[21]*2)==0{return 0;}}i=0;while i<9{if jj_tx1_disjoint(r,d[23],jj_tx1_pair_ptr(d,i),jj_tx1_pair_slots(d,i))==0{return 0;}i=i+1;}}return 1;}
fn jj_tx1_descriptor_valid(d:*i64)->i64{if d==0{return 0;}if d[0]!=0x4a4a545831444553{return 0;}if d[1]!=1{return 0;}if ((d as i64)&7)!=0{return 0;}if d[24]!=(d as i64){return 0;}if d[25]!=0x7f{return 0;}if d[26]!=1{return 0;}if d[31]!=0{return 0;}if d[23]!=0{if d[22]==0{return 0;}if d[23]<16{return 0;}}else{if d[22]!=0{return 0;}}if jj_tx1_protect_digest(d[20] as *i64,d[21])!=d[27]{return 0;}if jj_tx1_pairs_valid(d)==0{return 0;}if jj_tx1_descriptor_disjoint(d)==0{return 0;}if jj_tx1_external_disjoint(d)==0{return 0;}if d[7]!=d[3]{return 0;}if d[17]<d[3]{return 0;}if d[19]<d[5]{return 0;}if d[9]>d[5]{return 0;}if d[13]<d[9]{return 0;}if d[15]<=0{return 0;}if jj_tx1_desc_seal(d)!=d[30]{return 0;}return 1;}
fn jj_tx1_candidate_valid(d:*i64)->i64{var cc:*i64=d[6] as *i64;var cg:*i64=d[8] as *i64;if jj_cir_function_validate(cc,d[7])==0{return 0;}if jj_cir_graph_v2_valid(cg,d[9])==0{return 0;}if cg[2]!=(cc as i64){return 0;}if cg[3]!=d[7]{return 0;}if d[11]<cg[14]{return 0;}if d[15]<cg[14]{return 0;}if d[13]<cg[6]{return 0;}jj_tx1_zero(d[12] as *i64,d[13]);jj_tx1_zero(d[14] as *i64,d[15]);var ok:i64=jj_cir_graph_v2_verify(cg,d[9],d[12] as *i64,d[13],d[14] as *i64,d[15]);jj_tx1_zero(d[12] as *i64,d[13]);jj_tx1_zero(d[14] as *i64,d[15]);if ok==0{return 0;}if jj_tx1_protect_digest(d[20] as *i64,d[21])!=d[27]{return 0;}if jj_tx1_desc_seal(d)!=d[30]{return 0;}return 1;}
fn jj_tx1_restore(d:*i64)->i64{jj_tx1_copy(d[2] as *i64,d[16] as *i64,d[3]);jj_tx1_copy(d[4] as *i64,d[18] as *i64,d[5]);return 1;}
fn jj_tx1_scrub(d:*i64)->i64{jj_tx1_zero(d[10] as *i64,d[11]);jj_tx1_zero(d[12] as *i64,d[13]);jj_tx1_zero(d[14] as *i64,d[15]);jj_tx1_zero(d[16] as *i64,d[17]);jj_tx1_zero(d[18] as *i64,d[19]);return 1;}
fn jj_tx1_receipt_write(d:*i64)->i64{var r:*i64=d[22] as *i64;if r==0{return 1;}jj_tx1_zero(r,d[23]);var dc:*i64=d[2] as *i64;var dg:*i64=d[4] as *i64;var cc:*i64=d[6] as *i64;var cg:*i64=d[8] as *i64;r[0]=0x4a4a545831524350;r[1]=1;r[2]=d[28];r[3]=dc[7];r[4]=d[29];r[5]=dg[12];r[6]=d[25];r[7]=3;r[8]=dc as i64;r[9]=dg as i64;r[10]=d[3];r[11]=d[5];r[12]=r as i64;r[13]=1;r[15]=0;r[14]=jj_tx1_receipt_seal(r);return r[14]!=0;}
fn jj_tx1_receipt_valid(r:*i64,n:i64)->i64{if r==0{return 0;}if ((r as i64)&7)!=0{return 0;}if n<16{return 0;}if r[0]!=0x4a4a545831524350{return 0;}if r[1]!=1{return 0;}if r[6]!=0x7f{return 0;}if r[7]!=3{return 0;}if r[8]==0{return 0;}if r[9]==0{return 0;}if r[10]<=0{return 0;}if r[11]<=0{return 0;}if r[12]!=(r as i64){return 0;}if r[13]!=1{return 0;}if r[15]!=0{return 0;}if jj_tx1_receipt_seal(r)!=r[14]{return 0;}return 1;}
fn jj_tx1_receipt_verify(r:*i64,n:i64)->i64{if jj_tx1_receipt_valid(r,n)==0{return 0;}var c:*i64=r[8] as *i64;var g:*i64=r[9] as *i64;if jj_cir_function_validate(c,r[10])==0{return 0;}if jj_cir_graph_v2_valid(g,r[11])==0{return 0;}if g[2]!=(c as i64){return 0;}if g[3]!=r[10]{return 0;}if c[7]!=r[3]{return 0;}if g[12]!=r[5]{return 0;}return 1;}
fn jj_tx1_snapshot(d:*i64)->i64{var dc:*i64=d[2] as *i64;var dg:*i64=d[4] as *i64;d[28]=0;d[29]=0;if jj_cir_function_validate(dc,d[3])!=0{d[28]=dc[7];}if jj_cir_graph_v2_valid(dg,d[5])!=0{d[29]=dg[12];}d[30]=0;d[30]=jj_tx1_desc_seal(d);if d[30]==0{return 0;}if jj_tx1_copy(d[16] as *i64,dc,d[3])==0{return 0;}if jj_tx1_copy(d[18] as *i64,dg,d[5])==0{jj_tx1_zero(d[16] as *i64,d[17]);return 0;}return 1;}
fn jj_tx1_guard(d:*i64)->i64{if jj_tx1_protect_digest(d[20] as *i64,d[21])!=d[27]{return 0;}if jj_tx1_desc_seal(d)!=d[30]{return 0;}return 1;}
fn jj_tx1_publish(d:*i64)->i64{var dc:*i64=d[2] as *i64;var dg:*i64=d[4] as *i64;if jj_tx1_copy(dc,d[6] as *i64,d[3])==0{return 0;}jj_tx1_zero(dg,d[5]);jj_tx1_zero(d[10] as *i64,d[11]);return jj_cir_graph_v2_build(dg,d[5],d[10] as *i64,d[11],dc,d[3]);}
fn jj_tx1_published_valid(d:*i64)->i64{var dc:*i64=d[2] as *i64;var dg:*i64=d[4] as *i64;jj_tx1_zero(d[12] as *i64,d[13]);jj_tx1_zero(d[14] as *i64,d[15]);if jj_cir_graph_v2_verify(dg,d[5],d[12] as *i64,d[13],d[14] as *i64,d[15])==0{return 0;}if jj_cir_function_validate(dc,d[3])==0{return 0;}if jj_cir_graph_v2_valid(dg,d[5])==0{return 0;}if jj_tx1_protect_digest(d[20] as *i64,d[21])!=d[27]{return 0;}return 1;}
fn jj_tx1_fail(d:*i64)->i64{jj_tx1_restore(d);jj_tx1_scrub(d);return 0;}
fn jj_tx1_commit(d:*i64)->i64{if jj_tx1_descriptor_valid(d)==0{return 0;}if jj_tx1_candidate_valid(d)==0{return 0;}if jj_tx1_snapshot(d)==0{jj_tx1_scrub(d);return 0;}if jj_tx1_guard(d)==0{jj_tx1_scrub(d);return 0;}if jj_tx1_publish(d)==0{return jj_tx1_fail(d);}if jj_tx1_published_valid(d)==0{return jj_tx1_fail(d);}if jj_tx1_receipt_write(d)==0{return jj_tx1_fail(d);}jj_tx1_scrub(d);return 1;}
fn jj_tx1_resource_contract(o:*i64,n:i64)->i64{if o==0{return 0;}if n<16{return 0;}o[0]=1;o[1]=32;o[2]=16;o[3]=6;o[4]=0;o[5]=1;o[6]=1;o[7]=1;o[8]=1;o[9]=1;o[10]=1;o[11]=0x7f;o[12]=0;o[13]=0;o[14]=0;o[15]=0;return 1;}
