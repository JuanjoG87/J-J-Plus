extern fn jj_ibf1_state_seal(p0:*i64)->i64;
fn jj_epm1_zero(p:*i64,n:i64)->i64{if p==0{return 0;}if n<0{return 0;}var i:i64=0;while i<n{p[i]=0;i=i+1;}return 1;}
fn jj_epm1_disjoint(a:*i64,an:i64,b:*i64,bn:i64)->i64{if a==0{return 0;}if b==0{return 0;}if an<=0{return 0;}if bn<=0{return 0;}if an>0x0fffffffffffffff{return 0;}if bn>0x0fffffffffffffff{return 0;}var av:i64=a as i64;var bv:i64=b as i64;if av<0{return 0;}if bv<0{return 0;}var az:i64=an*8;var bz:i64=bn*8;if av>0x7fffffffffffffff-az{return 0;}if bv>0x7fffffffffffffff-bz{return 0;}var ae:i64=av+az;var be:i64=bv+bz;if ae<=bv{return 1;}if be<=av{return 1;}return 0;}
fn jj_epm1_desc_seal(d:*i64)->i64{if d==0{return 0;}var h:i64=(d as i64)^0x4a4a45504d314445;var i:i64=0;while i<14{var v:i64=d[i];if i==13{v=0;}h=((h<<7)|(h>>>57))^v^((i+67)*0x45d9f3b);i=i+1;}if h==0{h=1;}return h;}
fn jj_epm1_receipt_raw(s:*i64)->i64{if s==0{return 0;}var h:i64=0x4a4a45504d315243;var i:i64=2;while i<=17{h=((h<<9)|(h>>>55))^s[i]^((i+71)*0x27d4eb2d);i=i+1;}i=20;while i<=29{h=((h<<5)|(h>>>59))^s[i]^((i+79)*0x165667b1);i=i+1;}if h==0{h=1;}return h;}
fn jj_epm1_state_seal(s:*i64)->i64{if s==0{return 0;}var h:i64=(s as i64)^0x4a4a45504d315354;var i:i64=0;while i<32{var v:i64=s[i];if i==30{v=0;}h=((h<<11)|(h>>>53))^v^((i+73)*0x165667b1);i=i+1;}if h==0{h=1;}return h;}
fn jj_epm1_desc_valid(d:*i64)->i64{if d==0{return 0;}if d[0]!=0x4a4a45504d314445{return 0;}var i:i64=1;while i<=7{if d[i]==0{return 0;}i=i+1;}if d[8]<=0{return 0;}if d[9]==0{return 0;}if d[10]<=0{return 0;}if d[11]==0{return 0;}if d[12]!=(d as i64){return 0;}if d[13]!=jj_epm1_desc_seal(d){return 0;}var v:*i64=d[11] as *i64;if v[0]!=0x4a4a494246565131{return 0;}if v[1]!=d[6]{return 0;}if v[12]==0{return 0;}if v[13]!=32{return 0;}if v[14]!=(v as i64){return 0;}if v[15]!=1{return 0;}if v[16]!=0{return 0;}if v[17]!=jj_ibf1_verify_request_seal(v){return 0;}return 1;}
fn jj_epm1_links_raw(core:*i64,m:*i64,life:*i64,pt:*i64,mod:*i64,fwd:*i64)->i64{if core==0{return 0;}if m==0{return 0;}if life==0{return 0;}if pt==0{return 0;}if mod==0{return 0;}if fwd==0{return 0;}if m[2]!=core[5]{return 0;}if m[4]!=core[2]{return 0;}if life[2]!=core[5]{return 0;}if life[4]!=core[2]{return 0;}if pt[2]!=core[5]{return 0;}if pt[4]!=(life as i64){return 0;}if fwd[2]!=(m as i64){return 0;}if fwd[3]!=(life as i64){return 0;}if fwd[4]!=(pt as i64){return 0;}if fwd[5]!=(mod as i64){return 0;}if fwd[6]<=0{return 0;}if fwd[6]>mod[2]{return 0;}var table:*i64=mod[5] as *i64;if table[fwd[6]-1]!=(pt as i64){return 0;}return 1;}
fn jj_epm1_links_desc(d:*i64)->i64{return jj_epm1_links_raw(d[1] as *i64,d[2] as *i64,d[3] as *i64,d[4] as *i64,d[5] as *i64,d[6] as *i64);}
fn jj_epm1_authorities_valid(d:*i64)->i64{if jj_epc1_verify(d[1] as *i64)==0{return 0;}if jj_mssa2_validate(d[2] as *i64)==0{return 0;}if jj_life2_state_valid(d[3] as *i64)==0{return 0;}if jj_ptfs_state_valid(d[4] as *i64)==0{return 0;}if jj_ipmr_state_valid(d[5] as *i64)==0{return 0;}if jj_ibf1_state_valid_proven(d[6] as *i64)==0{return 0;}return jj_epm1_links_desc(d);}
fn jj_epm1_reconstruct(d:*i64)->i64{if jj_ptfs_verify(d[4] as *i64,d[7] as *i64,d[8])==0{return 0;}if jj_ipmr_verify(d[5] as *i64,d[9] as *i64,d[10])==0{return 0;}if jj_ibf1_verify_proven(d[11] as *i64)==0{return 0;}return 1;}
fn jj_epm1_authority_disjoint(p:*i64,n:i64,d:*i64)->i64{var core:*i64=d[1] as *i64;var fwd:*i64=d[6] as *i64;if jj_epc1_external_disjoint(p,n,core)==0{return 0;}if jj_epm1_disjoint(p,n,fwd,40)==0{return 0;}if jj_ibf1_state_external_disjoint(p,n,fwd)==0{return 0;}return 1;}
fn jj_epm1_vbuffers_disjoint(p:*i64,n:i64,v:*i64)->i64{if jj_epm1_disjoint(p,n,v,18)==0{return 0;}if jj_epm1_disjoint(p,n,v[2] as *i64,v[3])==0{return 0;}if jj_epm1_disjoint(p,n,v[4] as *i64,v[5])==0{return 0;}if jj_epm1_disjoint(p,n,v[6] as *i64,v[7])==0{return 0;}if jj_epm1_disjoint(p,n,v[8] as *i64,20)==0{return 0;}if jj_epm1_disjoint(p,n,v[10] as *i64,v[11])==0{return 0;}if jj_epm1_disjoint(p,n,v[12] as *i64,v[13])==0{return 0;}return 1;}
fn jj_epm1_vbuffers_authority_disjoint(v:*i64,d:*i64)->i64{if jj_epm1_authority_disjoint(v,18,d)==0{return 0;}if jj_epm1_authority_disjoint(v[2] as *i64,v[3],d)==0{return 0;}if jj_epm1_authority_disjoint(v[4] as *i64,v[5],d)==0{return 0;}if jj_epm1_authority_disjoint(v[6] as *i64,v[7],d)==0{return 0;}if jj_epm1_authority_disjoint(v[8] as *i64,20,d)==0{return 0;}if jj_epm1_authority_disjoint(v[10] as *i64,v[11],d)==0{return 0;}if jj_epm1_authority_disjoint(v[12] as *i64,v[13],d)==0{return 0;}return 1;}
fn jj_epm1_descriptor_disjoint(d:*i64)->i64{var pw:*i64=d[7] as *i64;var mw:*i64=d[9] as *i64;var v:*i64=d[11] as *i64;if jj_epm1_authority_disjoint(d,14,d)==0{return 0;}if jj_epm1_authority_disjoint(pw,d[8],d)==0{return 0;}if jj_epm1_authority_disjoint(mw,d[10],d)==0{return 0;}if jj_epm1_vbuffers_authority_disjoint(v,d)==0{return 0;}if jj_epm1_disjoint(d,14,pw,d[8])==0{return 0;}if jj_epm1_disjoint(d,14,mw,d[10])==0{return 0;}if jj_epm1_vbuffers_disjoint(d,14,v)==0{return 0;}if jj_epm1_disjoint(pw,d[8],mw,d[10])==0{return 0;}if jj_epm1_vbuffers_disjoint(pw,d[8],v)==0{return 0;}if jj_epm1_vbuffers_disjoint(mw,d[10],v)==0{return 0;}return 1;}
fn jj_epm1_deep(d:*i64)->i64{if jj_epm1_authorities_valid(d)==0{return 0;}if jj_epm1_descriptor_disjoint(d)==0{return 0;}return jj_epm1_reconstruct(d);}
fn jj_epm1_build_disjoint(s:*i64,d:*i64)->i64{if jj_epm1_descriptor_disjoint(d)==0{return 0;}if jj_epm1_authority_disjoint(s,32,d)==0{return 0;}if jj_epm1_disjoint(s,32,d,14)==0{return 0;}if jj_epm1_disjoint(s,32,d[7] as *i64,d[8])==0{return 0;}if jj_epm1_disjoint(s,32,d[9] as *i64,d[10])==0{return 0;}if jj_epm1_vbuffers_disjoint(s,32,d[11] as *i64)==0{return 0;}return 1;}
fn jj_epm1_build(s:*i64,n:i64,d:*i64)->i64{if s==0{return 0;}if n!=32{return 0;}if jj_epm1_desc_valid(d)==0{return 0;}if jj_epm1_authorities_valid(d)==0{return 0;}if jj_epm1_build_disjoint(s,d)==0{return 0;}if jj_epm1_reconstruct(d)==0{return 0;}var core:*i64=d[1] as *i64;var m:*i64=d[2] as *i64;var life:*i64=d[3] as *i64;var pt:*i64=d[4] as *i64;var mod:*i64=d[5] as *i64;var fwd:*i64=d[6] as *i64;jj_epm1_zero(s,32);s[0]=0x4a4a45504d315354;s[1]=1;s[2]=core as i64;s[3]=core[18];s[4]=core[2];s[5]=core[4];s[6]=core[5];s[7]=core[7];s[8]=m as i64;s[9]=m[13];s[10]=life as i64;s[11]=life[22];s[12]=pt as i64;s[13]=pt[22];s[14]=mod as i64;s[15]=mod[22];s[16]=fwd as i64;s[17]=fwd[23];s[19]=s as i64;s[20]=6;s[21]=6;s[22]=3;s[23]=6;s[24]=1;s[25]=1;s[26]=0;s[27]=0;s[28]=0;s[29]=0;s[31]=0;s[18]=jj_epm1_receipt_raw(s);s[30]=jj_epm1_state_seal(s);if s[18]==0{return 0;}if s[30]==0{return 0;}return 1;}
fn jj_epm1_structural_valid(s:*i64)->i64{if s==0{return 0;}if s[0]!=0x4a4a45504d315354{return 0;}if s[1]!=1{return 0;}if s[2]==0{return 0;}if s[8]==0{return 0;}if s[10]==0{return 0;}if s[12]==0{return 0;}if s[14]==0{return 0;}if s[16]==0{return 0;}if s[19]!=(s as i64){return 0;}if s[20]!=6{return 0;}if s[21]!=6{return 0;}if s[22]!=3{return 0;}if s[23]!=6{return 0;}if s[24]!=1{return 0;}if s[25]!=1{return 0;}if s[26]!=0{return 0;}if s[27]!=0{return 0;}if s[28]!=0{return 0;}if s[29]!=0{return 0;}if s[31]!=0{return 0;}var core:*i64=s[2] as *i64;var m:*i64=s[8] as *i64;var life:*i64=s[10] as *i64;var pt:*i64=s[12] as *i64;var mod:*i64=s[14] as *i64;var fwd:*i64=s[16] as *i64;if jj_epc1_structural_valid(core)==0{return 0;}if core[18]!=s[3]{return 0;}if core[2]!=s[4]{return 0;}if core[4]!=s[5]{return 0;}if core[5]!=s[6]{return 0;}if core[7]!=s[7]{return 0;}if m[13]!=s[9]{return 0;}if life[22]!=s[11]{return 0;}if pt[22]!=s[13]{return 0;}if mod[22]!=s[15]{return 0;}if fwd[23]!=s[17]{return 0;}if m[13]!=jj_mssa2_seal(m){return 0;}if life[22]!=jj_life2_state_seal(life){return 0;}if pt[22]!=jj_ptfs_state_seal(pt){return 0;}if mod[22]!=jj_ipmr_state_seal(mod){return 0;}if jj_ibf1_state_valid_proven(fwd)==0{return 0;}if jj_epm1_links_raw(core,m,life,pt,mod,fwd)==0{return 0;}if s[18]!=jj_epm1_receipt_raw(s){return 0;}if s[30]!=jj_epm1_state_seal(s){return 0;}return 1;}
fn jj_epm1_verify(s:*i64,d:*i64)->i64{if jj_epm1_structural_valid(s)==0{return 0;}if jj_epm1_desc_valid(d)==0{return 0;}if d[1]!=s[2]{return 0;}if d[2]!=s[8]{return 0;}if d[3]!=s[10]{return 0;}if d[4]!=s[12]{return 0;}if d[5]!=s[14]{return 0;}if d[6]!=s[16]{return 0;}if jj_epm1_authorities_valid(d)==0{return 0;}if jj_epm1_build_disjoint(s,d)==0{return 0;}return jj_epm1_reconstruct(d);}
