// bounded SCC classification and reducibility over reachable CFG.
extern fn jj_lg_zero(p0:*i64,p1:i64)->i64;
extern fn jj_lg_edge(p0:*i64,p1:*i64,p2:i64,p3:i64)->i64;
extern fn jj_lg_dom_has(p0:*i64,p1:i64,p2:i64)->i64;
fn jj_lg_walk(ctx:*i64,seed:i64,mode:i64,out:*i64,q:*i64)->i64{var n:i64=ctx[1];var reach:*i64=ctx[6] as *i64;var a:*i64=ctx[7] as *i64;var b:*i64=ctx[8] as *i64;if seed<0{return 0;}if seed>=n{return 0;}jj_lg_zero(out,n);out[seed]=1;q[0]=seed;var h:i64=0;var t:i64=1;while h<t{var x:i64=q[h];h=h+1;if mode==0{var y:i64=a[x];if y>=0{if reach[y]!=0{if out[y]==0{out[y]=1;q[t]=y;t=t+1;}}}y=b[x];if y>=0{if reach[y]!=0{if out[y]==0{out[y]=1;q[t]=y;t=t+1;}}}}else{if mode==2{var y2:i64=a[x];if y2>=0{if out[y2]==0{out[y2]=1;q[t]=y2;t=t+1;}}y2=b[x];if y2>=0{if out[y2]==0{out[y2]=1;q[t]=y2;t=t+1;}}}else{var p:i64=0;while p<n{if reach[p]!=0{if jj_lg_edge(a,b,p,x)!=0{if out[p]==0{out[p]=1;q[t]=p;t=t+1;}}}p=p+1;}}}}return t;}
fn jj_lg_component(ctx:*i64,seed:i64,cid:i64,d:*i64,ws:*i64)->i64{var n:i64=ctx[1];var reach:*i64=ctx[6] as *i64;var a:*i64=ctx[7] as *i64;var b:*i64=ctx[8] as *i64;var scc:*i64=ws[0] as *i64;var fw:*i64=ws[1] as *i64;var rv:*i64=ws[2] as *i64;var q:*i64=ws[3] as *i64;var info:*i64=ws[4] as *i64;if jj_lg_walk(ctx,seed,0,fw,q)==0{return 0;}if jj_lg_walk(ctx,seed,1,rv,q)==0{return 0;}var size:i64=0;var has0:i64=0;var i:i64=0;while i<n{if fw[i]!=0{if rv[i]!=0{scc[i]=cid;size=size+1;if i==0{has0=1;}}}i=i+1;}var cyc:i64=0;if size>1{cyc=1;}else{if a[seed]==seed{cyc=1;}if b[seed]==seed{cyc=1;}}var entries:i64=0;var header:i64=0-1;if cyc!=0{i=0;while i<n{if scc[i]==cid{var ext:i64=0;var p:i64=0;while p<n{if reach[p]!=0{if scc[p]!=cid{if jj_lg_edge(a,b,p,i)!=0{ext=1;}}}p=p+1;}if ext!=0{entries=entries+1;header=i;}}i=i+1;}if entries==0{if has0!=0{header=0;}}}var ok:i64=1;if cyc!=0{if header<0{ok=0;}if entries>1{ok=0;}if header>=0{i=0;while i<n{if scc[i]==cid{if jj_lg_dom_has(d,i,header)==0{ok=0;}}i=i+1;}}}info[0]=size;info[1]=cyc;info[2]=header;info[3]=ok;return 1;}
fn jj_loop_scc_build(ctx:*i64,r:*i64,d:*i64,ws:*i64)->i64{var n:i64=ctx[1];var reach:*i64=ctx[6] as *i64;var scc:*i64=ws[0] as *i64;var info:*i64=ws[4] as *i64;var i:i64=0;while i<n{scc[i]=0-1;i=i+1;}var count:i64=0;var cyclic:i64=0;var bad:i64=0;var seed:i64=0;while seed<n{if reach[seed]!=0{if scc[seed]<0{if jj_lg_component(ctx,seed,count,d,ws)==0{return 0;}if info[1]!=0{cyclic=cyclic+1;if info[3]==0{bad=bad+1;}}count=count+1;}}seed=seed+1;}r[5]=count;r[6]=cyclic;r[7]=bad;return 1;}
fn jj_lg_backedges(ctx:*i64,r:*i64,d:*i64)->i64{var n:i64=ctx[1];var reach:*i64=ctx[6] as *i64;var a:*i64=ctx[7] as *i64;var b:*i64=ctx[8] as *i64;var i:i64=0;while i<n{if reach[i]!=0{var t:i64=a[i];if t>=0{if jj_lg_dom_has(d,i,t)!=0{r[8]=r[8]+1;}}t=b[i];if t>=0{if jj_lg_dom_has(d,i,t)!=0{r[8]=r[8]+1;}}}i=i+1;}return 1;}
