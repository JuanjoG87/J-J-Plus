// R749 must-execute v1. Conservative natural-loop authority for fault-safe LICM.
// A member block is must-execute only when it dominates every latch and every
// exiting member block. This keeps zero-trip paths fail-closed.
extern fn jj_nlf1_state_valid(p0:*i64)->i64;
extern fn jj_nlf1_member(p0:*i64,p1:i64,p2:i64)->i64;
extern fn jj_nlf1_latch(p0:*i64,p1:i64,p2:i64)->i64;
extern fn jj_nlf1_succ(p0:*i64,p1:i64,p2:i64)->i64;
extern fn jj_cir_graph_v2_dominates(p0:*i64,p1:i64,p2:i64,p3:i64)->i64;
fn jj_must1_zero(p:*i64,n:i64)->i64{if p==0{return 0;}if n<0{return 0;}var i:i64=0;while i<n{p[i]=0;i=i+1;}return 1;}
fn jj_must1_disjoint(a:*i64,an:i64,b:*i64,bn:i64)->i64{if a==0{return 0;}if b==0{return 0;}if an<=0{return 0;}if bn<=0{return 0;}if an>0x0fffffffffffffff{return 0;}if bn>0x0fffffffffffffff{return 0;}var av:i64=a as i64;var bv:i64=b as i64;if av<0{return 0;}if bv<0{return 0;}var az:i64=an*8;var bz:i64=bn*8;if av>0x7fffffffffffffff-az{return 0;}if bv>0x7fffffffffffffff-bz{return 0;}var ae:i64=av+az;var be:i64=bv+bz;if ae<=bv{return 1;}if be<=av{return 1;}return 0;}
fn jj_must1_need(loops:i64,blocks:i64)->i64{if loops<=0{return 0;}if blocks<=0{return 0;}if blocks>=0x7fffffffffffffff{return 0;}var stride:i64=blocks+1;if loops>0x7fffffffffffffff/stride{return 0;}return loops*stride;}
fn jj_must1_forest_disjoint(p:*i64,n:i64,f:*i64)->i64{if jj_must1_disjoint(p,n,f,24)==0{return 0;}if jj_must1_disjoint(p,n,f[9] as *i64,f[10])==0{return 0;}if jj_must1_disjoint(p,n,f[11] as *i64,f[12])==0{return 0;}if jj_must1_disjoint(p,n,f[13] as *i64,f[14])==0{return 0;}if jj_must1_disjoint(p,n,f[15] as *i64,f[16])==0{return 0;}if jj_must1_disjoint(p,n,f[2] as *i64,f[3])==0{return 0;}if jj_must1_disjoint(p,n,f[4] as *i64,f[5])==0{return 0;}return 1;}
fn jj_must1_geometry(s:*i64)->i64{var need:i64=jj_must1_need(s[8],s[9]);if need==0{return 0;}if s[11]!=need{return 0;}if jj_must1_disjoint(s,24,s[10] as *i64,s[11])==0{return 0;}if jj_must1_forest_disjoint(s,24,s[2] as *i64)==0{return 0;}if jj_must1_forest_disjoint(s[10] as *i64,s[11],s[2] as *i64)==0{return 0;}return 1;}
fn jj_must1_state_seal(s:*i64)->i64{if s==0{return 0;}var h:i64=(s as i64)^0x4a4a4d5553543153;var i:i64=0;while i<24{var v:i64=s[i];if i==22{v=0;}h=((h<<7)|(h>>>57))^v^((i+29)*0x45d9f3b);i=i+1;}if s[10]!=0{if s[11]>0{var m:*i64=s[10] as *i64;i=0;while i<s[11]{h=((h<<9)|(h>>>55))^m[i]^((i+31)*0x27d4eb2d);i=i+1;}}}if h==0{h=1;}return h;}
fn jj_must1_structural_valid(s:*i64)->i64{if s==0{return 0;}if s[0]!=0x4a4a4d5553543153{return 0;}if s[1]!=1{return 0;}if s[2]==0{return 0;}if s[4]==0{return 0;}if s[6]==0{return 0;}if s[8]<=0{return 0;}if s[9]<=0{return 0;}if s[10]==0{return 0;}if jj_must1_need(s[8],s[9])!=s[11]{return 0;}if s[12]!=s[9]+1{return 0;}if s[13]<=0{return 0;}if s[17]!=(s as i64){return 0;}if s[18]!=1{return 0;}if s[19]!=1{return 0;}if s[20]!=1{return 0;}if s[21]!=0{return 0;}if s[23]!=0{return 0;}if jj_must1_geometry(s)==0{return 0;}var f:*i64=s[2] as *i64;var g:*i64=s[4] as *i64;var c:*i64=s[6] as *i64;if f[2]!=(g as i64){return 0;}if f[4]!=(c as i64){return 0;}if f[8]!=s[8]{return 0;}if f[7]!=s[9]{return 0;}if f[22]!=s[14]{return 0;}if g[12]!=s[15]{return 0;}if c[7]!=s[16]{return 0;}var m:*i64=s[10] as *i64;var count:i64=0;var i:i64=0;while i<s[11]{if m[i]!=0{if m[i]!=1{return 0;}count=count+1;}i=i+1;}if count!=s[13]{return 0;}if s[22]!=jj_must1_state_seal(s){return 0;}return 1;}
fn jj_must1_state_valid(s:*i64)->i64{if jj_must1_structural_valid(s)==0{return 0;}return jj_nlf1_state_valid(s[2] as *i64);}
fn jj_must1_exit_source(f:*i64,id:i64,b:i64)->i64{if jj_nlf1_member(f,id,b)==0{return 0;}var g:*i64=f[2] as *i64;var i:i64=0;while i<2{var t:i64=jj_nlf1_succ(g,b,i);if t>0{if jj_nlf1_member(f,id,t)==0{return 1;}}i=i+1;}return 0;}
fn jj_must1_candidate(f:*i64,id:i64,b:i64)->i64{if jj_nlf1_member(f,id,b)==0{return 0;}var g:*i64=f[2] as *i64;var x:i64=1;var obligations:i64=0;while x<=f[7]{if jj_nlf1_member(f,id,x)!=0{var required:i64=jj_nlf1_latch(f,id,x);if required==0{required=jj_must1_exit_source(f,id,x);}if required!=0{obligations=obligations+1;if jj_cir_graph_v2_dominates(g,f[3],b,x)==0{return 0;}}}x=x+1;}return obligations>0;}
fn jj_must1_build(s:*i64,n:i64,f:*i64,m:*i64,mn:i64)->i64{if s==0{return 0;}if n!=24{return 0;}if f==0{return 0;}if m==0{return 0;}if jj_nlf1_state_valid(f)==0{return 0;}var need:i64=jj_must1_need(f[8],f[7]);if need==0{return 0;}if mn<need{return 0;}if jj_must1_disjoint(s,n,m,mn)==0{return 0;}if jj_must1_forest_disjoint(s,n,f)==0{return 0;}if jj_must1_forest_disjoint(m,mn,f)==0{return 0;}jj_must1_zero(s,24);jj_must1_zero(m,mn);var count:i64=0;var id:i64=1;while id<=f[8]{var b:i64=1;while b<=f[7]{if jj_must1_candidate(f,id,b)!=0{m[(id-1)*(f[7]+1)+b]=1;count=count+1;}b=b+1;}id=id+1;}if count<=0{return 0;}var g:*i64=f[2] as *i64;var c:*i64=f[4] as *i64;s[0]=0x4a4a4d5553543153;s[1]=1;s[2]=f as i64;s[3]=24;s[4]=g as i64;s[5]=f[3];s[6]=c as i64;s[7]=f[5];s[8]=f[8];s[9]=f[7];s[10]=m as i64;s[11]=need;s[12]=f[7]+1;s[13]=count;s[14]=f[22];s[15]=g[12];s[16]=c[7];s[17]=s as i64;s[18]=1;s[19]=1;s[20]=1;s[21]=0;s[23]=0;s[22]=jj_must1_state_seal(s);if s[22]==0{return 0;}return 1;}
fn jj_must1_block(s:*i64,id:i64,b:i64)->i64{if jj_must1_state_valid(s)==0{return 0;}if id<=0{return 0;}if id>s[8]{return 0;}if b<=0{return 0;}if b>s[9]{return 0;}var m:*i64=s[10] as *i64;return m[(id-1)*s[12]+b];}
fn jj_must1_semantic_equal(a:*i64,b:*i64)->i64{if jj_must1_state_valid(a)==0{return 0;}if jj_must1_state_valid(b)==0{return 0;}if a[8]!=b[8]{return 0;}if a[9]!=b[9]{return 0;}if a[13]!=b[13]{return 0;}var am:*i64=a[10] as *i64;var bm:*i64=b[10] as *i64;var i:i64=0;while i<a[11]{if am[i]!=bm[i]{return 0;}i=i+1;}return 1;}
fn jj_must1_resource_contract(out:*i64,n:i64)->i64{if out==0{return 0;}if n<24{return 0;}jj_must1_zero(out,24);out[0]=1;out[1]=24;out[2]=1;out[3]=1;out[4]=1;out[5]=1;out[6]=1;out[7]=1;out[8]=1;out[9]=1;out[10]=1;out[11]=1;out[12]=0;out[13]=0;out[14]=1;out[15]=1;out[16]=1;out[17]=1;out[18]=1;out[19]=0;out[20]=0;out[21]=0;out[22]=0;out[23]=1;return 1;}
