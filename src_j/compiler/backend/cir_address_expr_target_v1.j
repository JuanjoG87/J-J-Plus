fn jj_ae1_field(s:*i64,id:i64,f:i64)->i64{if jj_ae1_state_valid(s)==0{return 0-1;}if id<=0{return 0-1;}if id>s[9]{return 0-1;}if f<2{return 0-1;}if f>12{return 0-1;}var r:*i64=s[10] as *i64;return r[(id-1)*16+f];}
fn jj_ae1_semantic_equal(a:*i64,b:*i64)->i64{if jj_ae1_state_valid(a)==0{return 0;}if jj_ae1_state_valid(b)==0{return 0;}var i:i64=0;while i<24{if i!=5{if i!=10{if i!=12{if i!=21{if i!=22{if a[i]!=b[i]{return 0;}}}}}}i=i+1;}var ar:*i64=a[10] as *i64;var br:*i64=b[10] as *i64;i=0;while i<a[9]*16{if i%16!=13{if i%16!=15{if ar[i]!=br[i]{return 0;}}}i=i+1;}return 1;}
