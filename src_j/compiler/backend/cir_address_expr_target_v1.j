fn jj_ae1_desc_seal(d:*i64)->i64{if d==0{return 0;}var h:i64=(d as i64)^0x4a4a414545584431;var i:i64=0;while i<8{var v:i64=d[i];if i==7{v=0;}h=((h<<5)|(h>>>59))^v^((i+3)*0x27d4eb2d);i=i+1;}if h==0{h=1;}return h;}
fn jj_ae1_desc_valid(d:*i64)->i64{if d==0{return 0;}if d[0]==0{return 0;}if d[1]<=0{return 0;}if d[2]==0{return 0;}if d[3]!=32{return 0;}if d[4]!=(d as i64){return 0;}if d[5]<=0{return 0;}if d[6]!=0{return 0;}if d[7]!=jj_ae1_desc_seal(d){return 0;}if jj_target_profile_validate(d[2] as *i64,d[3])==0{return 0;}return 1;}
fn jj_ae1_node_base(c:*i64,n:i64)->i64{return c[11]+(n-1)*4;}
fn jj_ae1_op(c:*i64,n:i64)->i64{return c[jj_ae1_node_base(c,n)];}
fn jj_ae1_address_count(c:*i64)->i64{var n:i64=1;var x:i64=0;while n<=c[3]{if jj_ae1_op(c,n)==36{x=x+1;}n=n+1;}return x;}
fn jj_ae1_select_form(kind:i64,disp:i64)->i64{if kind==5{return 2;}if kind==8{return 2;}if kind==6{if disp<=4095{return 3;}if disp%4096==0{if disp/4096<=4095{return 3;}}return 1;}if kind==9{if disp<=2047{return 4;}return 1;}if kind==10{if disp<=2047{return 4;}return 1;}if kind==7{return 1;}return 0;}
fn jj_ae1_select_parts(kind:i64,form:i64,disp:i64)->i64{if form==2{return 1;}if form==3{return 1;}if form==4{return 1;}if kind==6{return 2;}if kind==7{return 2;}if kind==8{return 1;}if kind==9{return 2;}if kind==10{return 2;}if kind==5{return 1;}return 0;}
fn jj_ae1_select_pressure(kind:i64,form:i64)->i64{if kind==8{if form==2{return 1;}return 2;}if form==1{return 2;}return 1;}
fn jj_ae1_flatten(c:*i64,node:i64,out:*i64)->i64{if node<=0{return 0;}if node>c[3]{return 0;}if jj_ae1_op(c,node)!=36{return 0;}var cur:i64=node;var disp:i64=0;var depth:i64=0;while cur>0{var b:i64=jj_ae1_node_base(c,cur);if c[b]!=36{break;}var off:i64=c[b+3];if off<0{return 0;}if disp>0x7fffffffffffffff-off{return 0;}disp=disp+off;cur=c[b+2];depth=depth+1;if depth>c[3]{return 0;}}if cur<=0{return 0;}if cur>=node{return 0;}out[0]=cur;out[1]=0;out[2]=1;out[3]=disp;out[4]=depth;return 1;}
fn jj_ae1_record_semantic(c:*i64,r:*i64)->i64{var f:[5]i64;if jj_ae1_flatten(c,r[2],f as *i64)==0{return 0;}if r[3]!=f[0]{return 0;}if r[4]!=f[1]{return 0;}if r[5]!=f[2]{return 0;}if r[6]!=f[3]{return 0;}if r[7]!=f[4]{return 0;}return 1;}
