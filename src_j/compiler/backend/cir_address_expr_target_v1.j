fn jj_ae1_record_seal(r:*i64)->i64{if r==0{return 0;}var h:i64=(r as i64)^0x4a4a414545585231;var i:i64=0;while i<16{var v:i64=r[i];if i==15{v=0;}h=((h<<7)|(h>>>57))^v^((i+5)*0x9e37);i=i+1;}if h==0{h=1;}return h;}
