fn jj_ae1_preflight(s:*i64,n:i64,r:*i64,rn:i64,c:*i64,d:*i64)->i64{if s==0{return 0;}if n!=24{return 0;}if r==0{return 0;}if c==0{return 0;}if jj_ae1_desc_valid(d)==0{return 0;}if jj_cir_function_validate(c,d[5])==0{return 0;}var count:i64=jj_ae1_address_count(c);if count<=0{return 0;}if count>0x0fffffffffffffff/16{return 0;}if rn<count*16{return 0;}if d[1]<c[3]+1{return 0;}var map:*i64=d[0] as *i64;var p:*i64=d[2] as *i64;if jj_ae1_disjoint(s,n,r,rn)==0{return 0;}if jj_ae1_disjoint(s,n,c,d[5])==0{return 0;}if jj_ae1_disjoint(s,n,d,8)==0{return 0;}if jj_ae1_disjoint(s,n,map,d[1])==0{return 0;}if jj_ae1_disjoint(s,n,p,32)==0{return 0;}if jj_ae1_disjoint(r,rn,c,d[5])==0{return 0;}if jj_ae1_disjoint(r,rn,d,8)==0{return 0;}if jj_ae1_disjoint(r,rn,map,d[1])==0{return 0;}if jj_ae1_disjoint(r,rn,p,32)==0{return 0;}if jj_ae1_disjoint(c,d[5],d,8)==0{return 0;}if jj_ae1_disjoint(c,d[5],map,d[1])==0{return 0;}if jj_ae1_disjoint(c,d[5],p,32)==0{return 0;}if jj_ae1_disjoint(d,8,map,d[1])==0{return 0;}if jj_ae1_disjoint(d,8,p,32)==0{return 0;}if jj_ae1_disjoint(map,d[1],p,32)==0{return 0;}return count;}
fn jj_ae1_build(s:*i64,n:i64,r:*i64,rn:i64,c:*i64,d:*i64)->i64{var count:i64=jj_ae1_preflight(s,n,r,rn,c,d);if count<=0{return 0;}var map:*i64=d[0] as *i64;var p:*i64=d[2] as *i64;jj_ae1_zero(s,24);jj_ae1_zero(r,count*16);jj_ae1_zero(map,c[3]+1);var node:i64=1;var id:i64=0;while node<=c[3]{if jj_ae1_op(c,node)==36{id=id+1;var rr:*i64=jj_ae1_at(r,(id-1)*16);if jj_ae1_fill_record(rr,id,node,c,p)==0{return 0;}map[node]=id;}node=node+1;}if id!=count{return 0;}s[0]=0x4a4a414545585331;s[1]=1;s[2]=c as i64;s[3]=d[5];s[4]=c[7];s[5]=p as i64;s[6]=32;s[7]=p[31];s[8]=p[2];s[9]=count;s[10]=r as i64;s[11]=rn;s[12]=map as i64;s[13]=d[1];s[14]=c[3];s[15]=16;s[16]=24;s[17]=6;s[18]=1;s[19]=1;s[20]=1;s[21]=s as i64;s[23]=0;s[22]=jj_ae1_state_seal(s);if s[22]==0{return 0;}return 1;}
fn jj_ae1_state_valid(s:*i64)->i64{if s==0{return 0;}if s[0]!=0x4a4a414545585331{return 0;}if s[1]!=1{return 0;}if s[2]==0{return 0;}if s[5]==0{return 0;}if s[10]==0{return 0;}if s[12]==0{return 0;}if s[21]!=(s as i64){return 0;}if s[6]!=32{return 0;}if s[15]!=16{return 0;}if s[16]!=24{return 0;}if s[17]!=6{return 0;}if s[18]!=1{return 0;}if s[19]!=1{return 0;}if s[20]!=1{return 0;}if s[23]!=0{return 0;}var c:*i64=s[2] as *i64;var p:*i64=s[5] as *i64;if jj_cir_function_validate(c,s[3])==0{return 0;}if c[7]!=s[4]{return 0;}if jj_target_profile_validate(p,s[6])==0{return 0;}if p[31]!=s[7]{return 0;}if p[2]!=s[8]{return 0;}if jj_ae1_address_count(c)!=s[9]{return 0;}if s[9]<=0{return 0;}if s[11]<s[9]*16{return 0;}if s[13]<c[3]+1{return 0;}if s[14]!=c[3]{return 0;}var r:*i64=s[10] as *i64;var map:*i64=s[12] as *i64;var id:i64=1;while id<=s[9]{var rr:*i64=jj_ae1_at(r,(id-1)*16);if rr[0]!=0x4a4a414545585231{return 0;}if rr[1]!=id{return 0;}if rr[2]<=0{return 0;}if rr[2]>c[3]{return 0;}if jj_ae1_op(c,rr[2])!=36{return 0;}if jj_ae1_record_semantic(c,rr)==0{return 0;}if rr[4]!=0{return 0;}if rr[5]!=1{return 0;}if rr[6]<0{return 0;}if rr[7]<=0{return 0;}if rr[8]!=s[8]{return 0;}if rr[9]!=jj_ae1_select_form(s[8],rr[6]){return 0;}if rr[10]!=jj_ae1_select_parts(s[8],rr[9],rr[6]){return 0;}if rr[11]!=jj_ae1_select_pressure(s[8],rr[9]){return 0;}if rr[12]!=1{return 0;}if rr[13]!=(rr as i64){return 0;}if rr[14]!=0{return 0;}if rr[15]!=jj_ae1_record_seal(rr){return 0;}if map[rr[2]]!=id{return 0;}id=id+1;}var node:i64=1;while node<=c[3]{if jj_ae1_op(c,node)==36{if map[node]<=0{return 0;}}else{if map[node]!=0{return 0;}}node=node+1;}if s[22]!=jj_ae1_state_seal(s){return 0;}return 1;}
