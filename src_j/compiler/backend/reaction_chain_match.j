// reaction network hot ReactionChain matcher and receipt replacement.
extern fn jj_rc_history_get(p0:*i64,p1:i64)->i64;
extern fn jj_rb_shift_modrm(p0:i64)->i64;extern fn jj_rb_read_imm(p0:*i8,p1:i64)->i64;extern fn jj_rb_slot(p0:*i8,p1:i64)->i64;extern fn jj_rb_binary_valid(p0:i64)->i64;extern fn jj_rc_emit(p0:*i8,p1:i64,p2:i64,p3:*i64)->i64;
fn jj_rc_try_history(code:*i8,end:i64,program:*i8,h:*i64,receipts:*i64)->i64{
 if code==0{return 0-1;}if program==0{return 0-1;}if h==0{return 0-1;}if receipts==0{return 0-1;}var fgr:*i64=receipts[0] as *i64;var reo:*i64=receipts[1] as *i64;var reom:*i64=receipts[2] as *i64;if fgr==0{return 0-1;}if reo==0{return 0-1;}if reom==0{return 0-1;}
 if jj_rc_history_get(h,0)!=2{return 0;}if jj_rc_history_get(h,7)!=2{return 0;}if jj_rc_history_get(h,14)!=1{return 0;}if jj_rb_shift_modrm(jj_rc_history_get(h,21))==0{return 0;}if jj_rb_binary_valid(jj_rc_history_get(h,28))==0{return 0;}if jj_rc_history_get(h,35)!=3{return 0;}if jj_rc_history_get(h,42)!=2{return 0;}if jj_rc_history_get(h,49)!=1{return 0;}if jj_rc_history_get(h,56)!=11{return 0;}if jj_rc_history_get(h,63)!=3{return 0;}if jj_rc_history_get(h,70)!=2{return 0;}if jj_rc_history_get(h,77)!=2{return 0;}if jj_rc_history_get(h,84)!=1{return 0;}if jj_rb_shift_modrm(jj_rc_history_get(h,91))==0{return 0;}if jj_rb_binary_valid(jj_rc_history_get(h,98))==0{return 0;}
 var i:i64=0;while i<15{if jj_rc_history_get(h,i*7+3)!=0{return 0;}i=i+1;}var slot:i64=jj_rb_slot(program,jj_rc_history_get(h,1));if jj_rb_slot(program,jj_rc_history_get(h,8))!=slot{return 0;}if jj_rb_slot(program,jj_rc_history_get(h,36))!=slot{return 0;}if jj_rb_slot(program,jj_rc_history_get(h,43))!=slot{return 0;}if jj_rb_slot(program,jj_rc_history_get(h,64))!=slot{return 0;}if jj_rb_slot(program,jj_rc_history_get(h,71))!=slot{return 0;}if jj_rb_slot(program,jj_rc_history_get(h,78))!=slot{return 0;}
 var k1:i64=jj_rb_read_imm(program,jj_rc_history_get(h,15));var imm:i64=jj_rb_read_imm(program,jj_rc_history_get(h,50));var k2:i64=jj_rb_read_imm(program,jj_rc_history_get(h,85));if k1<0{return 0;}if k1>=64{return 0;}if k2<0{return 0;}if k2>=64{return 0;}var d:[8]i64;d[0]=slot;d[1]=jj_rc_history_get(h,21);d[2]=jj_rc_history_get(h,28);d[3]=k1;d[4]=imm;d[5]=jj_rc_history_get(h,91);d[6]=jj_rc_history_get(h,98);d[7]=k2;if jj_rc_emit(code,jj_rc_history_get(h,2),end,d as *i64)==0{return 0;}
 fgr[0]=jj_rc_history_get(h,4);reo[0]=jj_rc_history_get(h,5);var packed:i64=jj_rc_history_get(h,6);var count:i64=(packed>>>16)&65535;var fp:i64=(packed>>>32)&65535;var ndr:i64=(packed>>>48)&65535;if count>=65535{return 0-1;}if ndr>65533{return 0-1;}var disp:i64=(0-((slot+1)*8))&65535;var imm_fold:i64=(imm^(imm>>>16)^(imm>>>32)^(imm>>>48))&65535;var token:i64=(0x43+d[1]*3+d[2]*5+k1*7+imm_fold*9+d[5]*11+d[6]*13+k2*17+disp)&65535;reom[0]=(packed&65535)|((count+1)<<16)|(((fp*257+token)&65535)<<32)|((ndr+2)<<48);return 1;
}
