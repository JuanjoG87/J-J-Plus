fn jj_lc2_rebuild(f:*i64,id:i64,out:*i64,os:i64,r:*i64,p:*i64)->i64{var c:*i64=f[4] as *i64;var count:i64=jj_lc2_record_count(f,id);if count<=0{return 0;}if jj_lc2_prefix_fill(c,r,count,p)==0{return 0;}if jj_lc2_assign_transport_ids(c,r,count,p)==0{return 0;}var z:[5]i64;z[0]=f as i64;z[1]=id;z[2]=r as i64;z[3]=count;z[4]=p as i64;if jj_cir_function_begin(out,os,c[4],c[5])==0{return 0;}var b:i64=1;while b<=c[2]{if jj_cir_function_add_block(out,os)!=b{return 0;}b=b+1;}b=1;while b<=c[2]{if jj_lc2_insert_transports(f,id,out,os,z as *i64,b)==0{return 0;}var q:i64=12+(b-1)*6;var i:i64=0;while i<c[q+1]{if jj_lc2_copy_node(f,id,out,os,z as *i64,c[q]+i)==0{return 0;}i=i+1;}if jj_lc2_set_term(f,id,out,os,z as *i64,b)==0{return 0;}b=b+1;}return jj_cir_function_finish(out,os);}
