fn jj_lc2_apply(q:*i64)->i64{var need:i64=jj_lc2_preflight(q);if need<=0{return 0;}var f:*i64=q[1] as *i64;var w:*i64=q[7] as *i64;var o:[1]i64;o[0]=0;if jj_lc2_forest_verify(f,w,o as *i64)==0{jj_lc2_zero(w,need);return 0;}if q[15]!=jj_lc2_req_seal(q){jj_lc2_zero(w,need);return 0;}var count:i64=jj_lc2_record_count(f,q[2]);if count<=0{jj_lc2_zero(w,need);return 0;}var r:*i64=jj_lc2_at(w,o[0]);o[0]=o[0]+count*12;var p:*i64=jj_lc2_at(w,o[0]);o[0]=o[0]+(f[4] as *i64)[2]+2;var map:*i64=jj_lc2_at(w,o[0]);o[0]=o[0]+(f[4] as *i64)[3]+1;if jj_lc2_fill_records(f,q[2],r,count)==0{jj_lc2_zero(w,need);return 0;}var tc:*i64=jj_lc2_at(w,o[0]);o[0]=o[0]+q[4];var g:*i64=f[2] as *i64;var tg:*i64=jj_lc2_at(w,o[0]);o[0]=o[0]+g[6];var tw:*i64=jj_lc2_at(w,o[0]);o[0]=o[0]+g[14];if jj_lc2_rebuild(f,q[2],tc,q[4],r,p)==0{jj_lc2_zero(w,need);return 0;}if jj_cir_graph_v2_build(tg,g[6],tw,g[14],tc,q[4])==0{jj_lc2_zero(w,need);return 0;}map[0]=0;var ok:i64=jj_lc2_commit(q,w,o as *i64,tc,tg,tw);jj_lc2_zero(w,need);return ok;}
fn jj_lc2_resource_contract(out:*i64,n:i64)->i64{if out==0{return 0;}if n<24{return 0;}jj_lc2_zero(out,24);out[0]=2;out[1]=16;out[2]=12;out[3]=6;out[4]=1;out[5]=1;out[6]=1;out[7]=1;out[8]=1;out[9]=1;out[10]=1;out[11]=1;out[12]=1;out[13]=0;out[14]=0;out[15]=0;out[16]=0;out[17]=0;out[18]=0;out[19]=0;out[20]=0;out[21]=0;out[22]=0;out[23]=1;return 1;}
