fn jj_ll2_zero(p:*i64,n:i64)->i64{if p==0{return 0;}if n<0{return 0;}var i:i64=0;while i<n{p[i]=0;i=i+1;}return 1;}
fn jj_ll2_at(p:*i64,o:i64)->*i64{return ((p as i64)+o*8) as *i64;}
fn jj_ll2_disjoint(a:*i64,an:i64,b:*i64,bn:i64)->i64{if a==0{return 0;}if b==0{return 0;}if an<=0{return 0;}if bn<=0{return 0;}if an>0x0fffffffffffffff{return 0;}if bn>0x0fffffffffffffff{return 0;}var av:i64=a as i64;var bv:i64=b as i64;if av<0{return 0;}if bv<0{return 0;}var az:i64=an*8;var bz:i64=bn*8;if av>0x7fffffffffffffff-az{return 0;}if bv>0x7fffffffffffffff-bz{return 0;}var ae:i64=av+az;var be:i64=bv+bz;if ae<=bv{return 1;}if be<=av{return 1;}return 0;}
fn jj_ll2_req_seal(q:*i64)->i64{if q==0{return 0;}var h:i64=(q as i64)^0x4a4a4c4c32525132;var i:i64=0;while i<16{var v:i64=q[i];if i==15{v=0;}h=((h<<7)|(h>>>57))^v^((i+23)*0x9e37);i=i+1;}if h==0{h=1;}return h;}
fn jj_ll2_binary(op:i64)->i64{if op==9{return 1;}if op==10{return 1;}if op==11{return 1;}if op==16{return 1;}if op==17{return 1;}if op==18{return 1;}return 0;}
fn jj_ll2_movable(op:i64)->i64{if op==2{return 1;}if op==36{return 1;}return jj_ll2_binary(op);}
fn jj_ll2_node_block(c:*i64,n:i64)->i64{if n<=0{return 0;}if n>c[3]{return 0;}var b:i64=1;while b<=c[2]{var q:i64=12+(b-1)*6;if n>=c[q]{if n<c[q]+c[q+1]{return b;}}b=b+1;}return 0;}
fn jj_ll2_used(c:*i64,v:i64)->i64{var n:i64=1;while n<=c[3]{var x:i64=c[11]+(n-1)*4;var op:i64=c[x];var a:i64=c[x+2];var b:i64=c[x+3];if op==3{if a==v{return 1;}}if op==32{if a==v{return 1;}}if op==33{if a==v{return 1;}if b==v{return 1;}}if op==36{if a==v{return 1;}}if op==37{if a==v{return 1;}}if jj_ll2_binary(op)!=0{if a==v{return 1;}if b==v{return 1;}}n=n+1;}var k:i64=1;while k<=c[2]{var q:i64=12+(k-1)*6;var t:i64=c[q+2];if t==1{if c[q+3]==v{return 1;}}if t==3{if c[q+3]==v{return 1;}}if t==4{if c[q+3]==v{return 1;}}k=k+1;}return 0;}
fn jj_ll2_operand_invariant(f:*i64,id:i64,marks:*i64,v:i64,pre:i64)->i64{if v<=0{return 0;}var c:*i64=f[4] as *i64;var b:i64=jj_ll2_node_block(c,v);if b<=0{return 0;}if jj_nlf1_member(f,id,b)==0{return jj_cir_graph_v2_dominates(f[2] as *i64,f[3],b,pre);}return marks[v];}
fn jj_ll2_candidate(f:*i64,id:i64,marks:*i64,v:i64,pre:i64)->i64{var c:*i64=f[4] as *i64;var b:i64=jj_ll2_node_block(c,v);if jj_nlf1_member(f,id,b)==0{return 0;}var x:i64=c[11]+(v-1)*4;var op:i64=c[x];if jj_ll2_movable(op)==0{return 0;}if jj_ll2_used(c,v)==0{return 0;}if op==2{return 1;}if op==36{return jj_ll2_operand_invariant(f,id,marks,c[x+2],pre);}if jj_ll2_operand_invariant(f,id,marks,c[x+2],pre)==0{return 0;}return jj_ll2_operand_invariant(f,id,marks,c[x+3],pre);}
fn jj_ll2_mark(f:*i64,id:i64,marks:*i64)->i64{var c:*i64=f[4] as *i64;var pre:i64=jj_nlf1_record_field(f,id,9);if pre<=0{return 0;}jj_ll2_zero(marks,c[3]+1);var changed:i64=1;var pass:i64=0;while changed!=0{if pass>c[3]{return 0;}changed=0;var v:i64=1;while v<=c[3]{if marks[v]==0{if jj_ll2_candidate(f,id,marks,v,pre)!=0{marks[v]=1;changed=1;}}v=v+1;}pass=pass+1;}var n:i64=0;var x:i64=1;while x<=c[3]{if marks[x]!=0{n=n+1;}x=x+1;}return n;}
fn jj_ll2_workspace_required(f:*i64,id:i64,ocs:i64,ogs:i64)->i64{if jj_nlf1_state_valid(f)==0{return 0;}if id<=0{return 0;}if id>f[8]{return 0;}if jj_nlf1_record_field(f,id,9)<=0{return 0;}var c:*i64=f[4] as *i64;var g:*i64=f[2] as *i64;if jj_cir_function_block_capacity(ocs)<c[2]{return 0;}if jj_cir_function_node_capacity(ocs)<c[3]{return 0;}if ogs<g[6]{return 0;}var nodes:i64=c[3]+1;var total:i64=24+f[10]+f[12]+f[14]+f[16]+f[17]*2+g[6]+g[14];total=total+nodes+nodes+ocs+g[6]+g[14]+g[6]+g[14]+ocs+ogs;if total<=0{return 0;}return total;}
fn jj_ll2_source_disjoint(p:*i64,n:i64,f:*i64)->i64{if jj_ll2_disjoint(p,n,f,24)==0{return 0;}if jj_ll2_disjoint(p,n,f[9] as *i64,f[10])==0{return 0;}if jj_ll2_disjoint(p,n,f[11] as *i64,f[12])==0{return 0;}if jj_ll2_disjoint(p,n,f[13] as *i64,f[14])==0{return 0;}if jj_ll2_disjoint(p,n,f[15] as *i64,f[16])==0{return 0;}if jj_ll2_disjoint(p,n,f[2] as *i64,f[3])==0{return 0;}if jj_ll2_disjoint(p,n,f[4] as *i64,f[5])==0{return 0;}return 1;}
fn jj_ll2_protect_disjoint(p:*i64,n:i64,t:*i64,c:i64)->i64{var i:i64=0;while i<c{if jj_ll2_disjoint(p,n,t[i*2] as *i64,t[i*2+1])==0{return 0;}i=i+1;}return 1;}
fn jj_ll2_preflight(q:*i64)->i64{if q==0{return 0;}if q[0]!=0x4a4a4c4c32525132{return 0;}if q[13]!=(q as i64){return 0;}if q[14]!=0{return 0;}if q[15]!=jj_ll2_req_seal(q){return 0;}var f:*i64=q[1] as *i64;if jj_nlf1_state_valid(f)==0{return 0;}if q[2]<=0{return 0;}if q[2]>f[8]{return 0;}if q[3]==0{return 0;}if q[5]==0{return 0;}if q[7]==0{return 0;}if q[9]==0{if q[10]!=0{return 0;}}else{if q[10]<=0{return 0;}}if q[11]!=0{if q[12]<16{return 0;}}else{if q[12]!=0{return 0;}}var need:i64=jj_ll2_workspace_required(f,q[2],q[4],q[6]);if need<=0{return 0;}if q[8]<need{return 0;}var oc:*i64=q[3] as *i64;var og:*i64=q[5] as *i64;var w:*i64=q[7] as *i64;if jj_ll2_disjoint(q,16,oc,q[4])==0{return 0;}if jj_ll2_disjoint(q,16,og,q[6])==0{return 0;}if jj_ll2_disjoint(q,16,w,q[8])==0{return 0;}if jj_ll2_disjoint(oc,q[4],og,q[6])==0{return 0;}if jj_ll2_disjoint(oc,q[4],w,q[8])==0{return 0;}if jj_ll2_disjoint(og,q[6],w,q[8])==0{return 0;}if jj_ll2_source_disjoint(oc,q[4],f)==0{return 0;}if jj_ll2_source_disjoint(og,q[6],f)==0{return 0;}if jj_ll2_source_disjoint(w,q[8],f)==0{return 0;}if q[10]>0{var t:*i64=q[9] as *i64;var tn:i64=q[10]*2;if jj_ll2_disjoint(q,16,t,tn)==0{return 0;}if jj_ll2_disjoint(oc,q[4],t,tn)==0{return 0;}if jj_ll2_disjoint(og,q[6],t,tn)==0{return 0;}if jj_ll2_disjoint(w,q[8],t,tn)==0{return 0;}if jj_ll2_protect_disjoint(oc,q[4],t,q[10])==0{return 0;}if jj_ll2_protect_disjoint(og,q[6],t,q[10])==0{return 0;}if jj_ll2_protect_disjoint(w,q[8],t,q[10])==0{return 0;}}if q[11]!=0{if jj_ll2_disjoint(q,16,q[11] as *i64,q[12])==0{return 0;}if jj_ll2_source_disjoint(q[11] as *i64,q[12],f)==0{return 0;}}return need;}
fn jj_ll2_forest_verify(f:*i64,w:*i64,o:*i64)->i64{var vs:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+24;var vr:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+f[10];var vm:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+f[12];var vl:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+f[14];var vo:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+f[16];var vw:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+f[17]*2;var g:*i64=f[2] as *i64;var rg:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+g[6];var rw:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+g[14];var d:[16]i64;d[0]=vm as i64;d[1]=f[12];d[2]=vl as i64;d[3]=f[14];d[4]=vo as i64;d[5]=f[16];d[6]=vw as i64;d[7]=f[17]*2;d[8]=rg as i64;d[9]=g[6];d[10]=rw as i64;d[11]=g[14];d[12]=d as i64;d[13]=f[3];d[14]=0;d[15]=0;d[15]=jj_nlf1_desc_seal(d as *i64);return jj_nlf1_verify(f,vs,vr,d as *i64);}
fn jj_ll2_make_map(f:*i64,id:i64,marks:*i64,map:*i64)->i64{var c:*i64=f[4] as *i64;var pre:i64=jj_nlf1_record_field(f,id,9);var next:i64=1;var b:i64=1;while b<=c[2]{var q:i64=12+(b-1)*6;var i:i64=0;while i<c[q+1]{var old:i64=c[q]+i;if marks[old]==0{map[old]=next;next=next+1;}i=i+1;}if b==pre{var v:i64=1;while v<=c[3]{if marks[v]!=0{map[v]=next;next=next+1;}v=v+1;}}b=b+1;}return next==c[3]+1;}
fn jj_ll2_map(map:*i64,v:i64)->i64{if v<=0{return v;}return map[v];}
fn jj_ll2_copy_node(f:*i64,out:*i64,os:i64,map:*i64,n:i64,b:i64)->i64{var c:*i64=f[4] as *i64;var x:i64=c[11]+(n-1)*4;var op:i64=c[x];var a:i64=c[x+2];var z:i64=c[x+3];if op==3{a=jj_ll2_map(map,a);}if op==32{a=jj_ll2_map(map,a);}if op==33{a=jj_ll2_map(map,a);z=jj_ll2_map(map,z);}if op==36{a=jj_ll2_map(map,a);}if op==37{a=jj_ll2_map(map,a);}if jj_ll2_binary(op)!=0{a=jj_ll2_map(map,a);z=jj_ll2_map(map,z);}return jj_cir_function_add_node(out,os,b,op,a,z)==map[n];}
fn jj_ll2_set_term(f:*i64,out:*i64,os:i64,map:*i64,b:i64)->i64{var c:*i64=f[4] as *i64;var q:i64=12+(b-1)*6;var t:i64=c[q+2];if t==1{return jj_cir_function_set_return(out,os,b,jj_ll2_map(map,c[q+3]));}if t==2{var x:i64=c[q+4]+1;if x<b{return jj_cir_function_set_backedge(out,os,b,x);}return jj_cir_function_set_jump(out,os,b,x);}if t==3{return jj_cir_function_set_branch_zero(out,os,b,jj_ll2_map(map,c[q+3]),c[q+4]+1,c[q+5]+1);}if t==4{return jj_cir_function_set_call_return(out,os,b,jj_ll2_map(map,c[q+3]),c[q+4],c[q+5]);}return 0;}
fn jj_ll2_rebuild(f:*i64,id:i64,out:*i64,os:i64,marks:*i64,map:*i64)->i64{var c:*i64=f[4] as *i64;var pre:i64=jj_nlf1_record_field(f,id,9);if jj_ll2_make_map(f,id,marks,map)==0{return 0;}if jj_cir_function_begin(out,os,c[4],c[5])==0{return 0;}var b:i64=1;while b<=c[2]{if jj_cir_function_add_block(out,os)!=b{return 0;}b=b+1;}b=1;while b<=c[2]{var q:i64=12+(b-1)*6;var i:i64=0;while i<c[q+1]{var old:i64=c[q]+i;if marks[old]==0{if jj_ll2_copy_node(f,out,os,map,old,b)==0{return 0;}}i=i+1;}if b==pre{var v:i64=1;while v<=c[3]{if marks[v]!=0{if jj_ll2_copy_node(f,out,os,map,v,b)==0{return 0;}}v=v+1;}if jj_ll2_set_term(f,out,os,map,b)==0{return 0;}}else{if jj_ll2_set_term(f,out,os,map,b)==0{return 0;}}b=b+1;}return jj_cir_function_finish(out,os);}
fn jj_ll2_commit(q:*i64,w:*i64,o:*i64,tc:*i64,tg:*i64,tw:*i64)->i64{var f:*i64=q[1] as *i64;var g:*i64=f[2] as *i64;var rg:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+g[6];var rw:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+g[14];var bc:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+q[4];var bg:*i64=jj_ll2_at(w,o[0]);var d:[32]i64;d[0]=0x4a4a545831444553;d[1]=1;d[2]=q[3];d[3]=q[4];d[4]=q[5];d[5]=q[6];d[6]=tc as i64;d[7]=q[4];d[8]=tg as i64;d[9]=g[6];d[10]=tw as i64;d[11]=g[14];d[12]=rg as i64;d[13]=g[6];d[14]=rw as i64;d[15]=g[14];d[16]=bc as i64;d[17]=q[4];d[18]=bg as i64;d[19]=q[6];d[20]=q[9];d[21]=q[10];d[22]=q[11];d[23]=q[12];d[24]=d as i64;d[25]=0x7f;d[26]=1;d[27]=jj_tx1_protect_digest(q[9] as *i64,q[10]);d[28]=0;d[29]=0;d[31]=0;d[30]=jj_tx1_desc_seal(d as *i64);return jj_tx1_commit(d as *i64);}
fn jj_ll2_apply(q:*i64)->i64{var need:i64=jj_ll2_preflight(q);if need<=0{return 0;}var f:*i64=q[1] as *i64;var w:*i64=q[7] as *i64;var o:[1]i64;o[0]=0;if jj_ll2_forest_verify(f,w,o as *i64)==0{jj_ll2_zero(w,need);return 0;}if q[15]!=jj_ll2_req_seal(q){jj_ll2_zero(w,need);return 0;}var c:*i64=f[4] as *i64;var marks:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+c[3]+1;var map:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+c[3]+1;var count:i64=jj_ll2_mark(f,q[2],marks);if count<=0{jj_ll2_zero(w,need);return 0;}var tc:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+q[4];var g:*i64=f[2] as *i64;var tg:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+g[6];var tw:*i64=jj_ll2_at(w,o[0]);o[0]=o[0]+g[14];if jj_ll2_rebuild(f,q[2],tc,q[4],marks,map)==0{jj_ll2_zero(w,need);return 0;}if jj_cir_graph_v2_build(tg,g[6],tw,g[14],tc,q[4])==0{jj_ll2_zero(w,need);return 0;}var ok:i64=jj_ll2_commit(q,w,o as *i64,tc,tg,tw);jj_ll2_zero(w,need);return ok;}
fn jj_ll2_resource_contract(out:*i64,n:i64)->i64{if out==0{return 0;}if n<24{return 0;}jj_ll2_zero(out,24);out[0]=2;out[1]=16;out[2]=6;out[3]=1;out[4]=1;out[5]=1;out[6]=1;out[7]=1;out[8]=1;out[9]=1;out[10]=1;out[11]=1;out[12]=1;out[13]=1;out[14]=0;out[15]=0;out[16]=0;out[17]=0;out[18]=0;out[19]=0;out[20]=0;out[21]=0;out[22]=0;out[23]=1;return 1;}
