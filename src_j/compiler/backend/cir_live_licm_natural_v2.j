// R748 natural-loop LICM v2. Moves fixed-point chains of pure scalar and
// AddressExpr nodes from any member block to a dedicated preheader.
extern fn jj_cir_function_begin(p0:*i64,p1:i64,p2:i64,p3:i64)->i64;
extern fn jj_cir_function_add_block(p0:*i64,p1:i64)->i64;
